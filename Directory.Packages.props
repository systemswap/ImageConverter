<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia packages -->
        <!-- Important: keep version in sync! -->
        <PackageVersion Include="Avalonia" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <!-- Bildverarbeitung: ImageMagick, 16 Bit pro Kanal. Q8 verlor beim gamma-korrekten
             Skalieren dunkle Tonwerte (6 von 41 Stufen, Q16: 32+). Doppelter Speicher, gleiche Paketgröße.
             Native Bibliothek steckt im Paket, keine Installation auf dem System. -->
        <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.17.2" />

        <!-- PDF für Druck und „Als PDF speichern" — plattformunabhängige Core-Variante, MIT -->
        <PackageVersion Include="PDFsharp" Version="6.2.4" />

        <!-- Drucken unter Windows (Druckdienst). Wird nur unter Windows aufgerufen. -->
        <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />

        <!-- KI-Modelle lokal ausführen. Native Laufzeit steckt im Paket. MIT.
             Windows: Paket mit DirectML (Grafikkarte jedes Herstellers über DirectX 12, Rückfall CPU). Microsoft pflegt
             es nur noch (letzte Fassung 1.24.4) — deshalb überall dieselbe Fassung, auch unter Linux, damit Programm-
             schnittstelle und Laufzeit zusammenpassen (auch für einen eigenen Linux-Bau mit ROCm/MIGraphX). -->
        <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
        <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />

        <!-- Test packages -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    </ItemGroup>
</Project>
