<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImageConverter.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImageConverter.ViewModels"
             xmlns:m="using:ImageConverter.Models"
             xmlns:c="using:ImageConverter.Controls"
             xmlns:ai="using:ImageConverter.Ai"
             xmlns:meta="using:ImageConverter.Core.Metadata"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="ImageConverter.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ============================================================ -->
        <!-- Kopfleiste: Dateien                                          -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" IsEnabled="{Binding IsIdle}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Classes="subtle" Content="{l:T '＋  Bilder'}"
                        Click="OnOpenFilesClick"
                        ToolTip.Tip="{l:T 'Bilder oder ganze Ordner öffnen — oder einfach ins Fenster ziehen.'}" />

                <!-- Blättern, wenn mehrere Bilder geladen sind -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="10,0,0,0"
                            IsVisible="{Binding HasMultipleFiles}">
                    <Button Classes="icon" Content="‹" FontSize="18"
                            Command="{Binding PreviousFileCommand}" ToolTip.Tip="{l:T 'Vorheriges Bild'}" />
                    <TextBlock Classes="label" Text="{Binding FilePosition}" Margin="4,0" />
                    <Button Classes="icon" Content="›" FontSize="18"
                            Command="{Binding NextFileCommand}" ToolTip.Tip="{l:T 'Nächstes Bild'}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="14,0,0,0" Spacing="1">
                    <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Classes="hint" Text="{Binding FileDetails}" />
                </StackPanel>

                <!-- Fehlermeldung, z. B. bei nicht unterstütztem Format -->
                <Border Grid.Column="3" HorizontalAlignment="Center" Margin="16,0"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#1FE0A100" BorderBrush="#66E0A100" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}" Padding="10,5">
                    <TextBlock Classes="hint" Text="{Binding ErrorMessage}" MaxWidth="460" />
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <Button Classes="icon" Content="☰" ToolTip.Tip="{l:T 'Einstellungen (KI-Modelle, Sprache)'}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Classes="icon" Content="?" ToolTip.Tip="{l:T 'Hilfe'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Fußleiste: Ziel, Export                                      -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="12,10" IsEnabled="{Binding IsIdle}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <!-- Meldung (Ergebnis des letzten Exports, Vorschläge …): bricht um, statt unter „Ziel“ und die Knöpfe zu
                     laufen — höchstens drei Zeilen, der ganze Text als Tooltip -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,12,0" VerticalAlignment="Center"
                      IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Grid.Column="0" Classes="good" Text="✓" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Classes="hint" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusMessage}" />
                    <Button Grid.Column="2" Classes="tool" Margin="10,0,0,0" VerticalAlignment="Center"
                            Content="{l:T 'Ordner öffnen'}" Click="OnOpenExportFolderClick"
                            IsVisible="{Binding LastExportFolder, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
                <!-- Speichern: ein Balken über alle Schritte, darunter der laufende Schritt -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="3"
                            Margin="0,0,12,0" IsVisible="{Binding IsExporting}">
                    <ProgressBar Value="{Binding ExportProgress}" Maximum="100" Width="240"
                                 Height="4" MinHeight="4" HorizontalAlignment="Left" />
                    <TextBlock Classes="hint" FontSize="11.5" Text="{Binding ExportStep}"
                               TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>

                <TextBlock Grid.Column="1" Classes="label" Margin="0,0,8,0" Text="{l:T 'Ziel'}" />

                <!-- Zielordner: Klick wählt einen Ordner, ✕ setzt auf „neben dem Original" zurück -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tool" Click="OnChooseOutputFolderClick" Padding="10,0"
                                ToolTip.Tip="{l:T 'Zielordner wählen. Ohne Auswahl landet das Ergebnis im Unterordner „konvertiert“ neben dem Original.'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding OutputFolderDisplay}" FontSize="12" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="label" Text="…" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Content="✕" Padding="8,0"
                                IsVisible="{Binding HasCustomOutputFolder}"
                                Command="{Binding ResetOutputFolderCommand}"
                                ToolTip.Tip="{l:T 'Zurück zu: neben dem Original › konvertiert'}" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" Classes="subtle" Content="{l:T 'Drucken …'}" Margin="0,0,8,0"
                        Command="{Binding PrintCommand}"
                        ToolTip.Tip="{l:T 'Drucken oder als PDF speichern — mehrere Bilder pro Seite, mit Abstand zum Ausschneiden (Strg+P).'}" />

                <Button Grid.Column="4" Classes="primary" Content="{l:T 'Exportieren'}"
                        Command="{Binding ExportCommand}"
                        ToolTip.Tip="{l:T 'Mit allen Einstellungen in voller Auflösung speichern. Vorhandene Dateien werden nie überschrieben.'}" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Hauptbereich: Einstellungen links, Bild rechts               -->
        <!-- ============================================================ -->
        <Grid ColumnDefinitions="Auto,352,Auto,*">

            <!-- Kachelleiste ganz links: wählt die Rubrik. Zugeklappt nur Icons, aufgeklappt
                 mit Name und Inhalt. Icons nach Lucide (ISC-Lizenz), 24er-Raster. -->
            <Border Grid.Column="0" Classes="rail">
                <DockPanel>
                    <ToggleButton x:Name="RailExpand" DockPanel.Dock="Bottom" Classes="railToggle"
                                  ToolTip.Tip="{l:T 'Leiste aufklappen: zeigt, was in jeder Rubrik steckt'}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 6,17 L 11,12 L 6,7 M 13,17 L 18,12 L 13,7" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <StackPanel Spacing="4">
                        <RadioButton x:Name="TabStandard" Classes="tile" GroupName="rubrik" IsChecked="True"
                                     ToolTip.Tip="{l:T 'Standard: Format · Zuschnitt · Größe · DPI · Schärfen'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 5,3 H 19 A 2,2 0 0 1 21,5 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 5 A 2,2 0 0 1 5,3 Z M 7,9 A 2,2 0 1 0 11,9 A 2,2 0 1 0 7,9 Z M 21,15 L 17.9,11.9 A 2,2 0 0 0 15.1,11.9 L 6,21" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Standard'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Format · Zuschnitt · Größe · DPI · Schärfen'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabAi" Classes="tile" GroupName="rubrik"
                                     ToolTip.Tip="{l:T 'KI: Bilder vergrößern und verbessern, Gesichter wiederherstellen'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,3 L 10.1,8.8 A 2,2 0 0 1 8.8,10.1 L 3,12 L 8.8,13.9 A 2,2 0 0 1 10.1,15.2 L 12,21 L 13.9,15.2 A 2,2 0 0 1 15.2,13.9 L 21,12 L 15.2,10.1 A 2,2 0 0 1 13.9,8.8 Z M 5,3 V 7 M 3,5 H 7 M 19,17 V 21 M 17,19 H 21" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'KI'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Vergrößern · Verbessern · Gesichter'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabRetouch" Classes="tile" GroupName="rubrik"
                                     IsChecked="{Binding Retouch.IsTabActive}"
                                     ToolTip.Tip="{l:T 'Entfernen: Wasserzeichen, Schrift oder Störendes übermalen und von der KI füllen lassen'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 7,21 L 3.7,17.7 A 1.5,1.5 0 0 1 3.7,15.6 L 13.6,5.7 A 1.5,1.5 0 0 1 15.7,5.7 L 20.3,10.3 A 1.5,1.5 0 0 1 20.3,12.4 L 11.7,21 Z M 9,10.3 L 15,16.3 M 7,21 H 21" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Entfernen'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Wasserzeichen · Schrift · Störendes'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabBackground" Classes="tile" GroupName="rubrik"
                                     IsChecked="{Binding Background.IsTabActive}"
                                     ToolTip.Tip="{l:T 'Hintergrund: Motiv automatisch freistellen, Hintergrund transparent oder unscharf'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 5,3 H 19 A 2,2 0 0 1 21,5 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 5 A 2,2 0 0 1 5,3 Z M 9,10 A 3,3 0 1 0 15,10 A 3,3 0 1 0 9,10 Z M 6,21 A 6,5 0 0 1 18,21" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Hintergrund'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Freistellen · Transparent · Unscharf'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabTools" Classes="tile" GroupName="rubrik"
                                     ToolTip.Tip="{l:T 'Tools: Helligkeit · Kontrast · Tiefen · Lichter · Dunst · Dynamik · Sättigung · Färben · Gleiche Farbe'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 21,4 H 14 M 10,4 H 3 M 21,12 H 12 M 8,12 H 3 M 21,20 H 16 M 12,20 H 3 M 14,2 V 6 M 8,10 V 14 M 16,18 V 22" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Tools'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Helligkeit · Kontrast · Tiefen · Lichter · Dunst · Dynamik · Sättigung · Färben · Gleiche Farbe'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabOutput" Classes="tile" GroupName="rubrik"
                                     ToolTip.Tip="{l:T 'Ausgabe: Metadaten · Farbprofil · Dateiname'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 15,2 H 6 A 2,2 0 0 0 4,4 V 20 A 2,2 0 0 0 6,22 H 18 A 2,2 0 0 0 20,20 V 7 Z M 14,2 V 6 A 2,2 0 0 0 16,8 H 20 M 10,9 H 8 M 16,13 H 8 M 16,17 H 8" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Ausgabe'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Metadaten · Farbprofil · Dateiname'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Einstellungen der gewählten Rubrik -->
            <!-- Während des Upscalings gesperrt: das Ergebnis gehört zu genau diesem Stand -->
            <ScrollViewer Grid.Column="1" IsEnabled="{Binding IsIdle}"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,12,8,12"
                          Classes="settings">
                <StackPanel Spacing="10">

                    <!-- ============================== Für alle / einzeln -->
                    <Border IsVisible="{Binding HasMultipleFiles}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="12,6">
                        <StackPanel Spacing="2">
                            <CheckBox IsChecked="{Binding ApplyToAll}"
                                      Content="{l:T 'Gleiche Einstellungen für alle Bilder'}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="300" Spacing="6">
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{l:T 'Haken gesetzt: alle Bilder teilen sich die Einstellungen.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Die Größe wird pro Bild umgerechnet: Die eingegebene Kante gilt, die andere folgt dem Seitenverhältnis des Bildes — nichts wird verzerrt.'}" />
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{l:T 'Haken entfernt: jedes Bild bekommt eigene Einstellungen.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Haken wieder setzen: alle Bilder übernehmen die Einstellungen des aktuellen Bildes.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Zuschnitt und Drehen gelten immer nur für das einzelne Bild.'}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                            </CheckBox>
                            <TextBlock Classes="hint" Margin="28,0,0,2"
                                       IsVisible="{Binding !ApplyToAll}"
                                       Text="{l:T 'Einstellungen gelten nur für dieses Bild.'}" />
                        </StackPanel>
                    </Border>

                    <!-- ############################## Rubrik Standard -->
                    <StackPanel Spacing="10" IsVisible="{Binding #TabStandard.IsChecked}">

                    <!-- ============================== Format -->
                    <HeaderedContentControl Header="{l:T 'FORMAT'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Format'}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Formats}"
                                          SelectedItem="{Binding SelectedFormat}" />
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Qualität'}" />
                                <Slider Grid.Column="1" Minimum="1" Maximum="100"
                                        Value="{Binding Quality}"
                                        IsEnabled="{Binding QualityApplies}"
                                        ToolTip.Tip="{l:T 'Höher = schöner, aber größere Datei. 75–85 ist für Fotos meist der beste Kompromiss.'}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding Quality, StringFormat='{}{0:F0}'}" />
                            </Grid>

                            <CheckBox IsChecked="{Binding Lossless}" IsVisible="{Binding LosslessAvailable}"
                                      Content="{l:T 'Verlustfrei'}" FontSize="12"
                                      ToolTip.Tip="{l:T 'Jedes Pixel bleibt exakt erhalten. Ideal für Grafiken, Screenshots und Buttons — bei Fotos deutlich größer.'}" />
                            <!-- 16 Bit: bei kräftiger Tonwert-Bearbeitung setzt die App den Haken selbst und zeigt „empfohlen“ -->
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HighBitDepthAvailable}">
                                <CheckBox IsChecked="{Binding HighBitDepth}" VerticalAlignment="Center"
                                          Content="{l:T '16 Bit je Kanal'}" FontSize="12"
                                          ToolTip.Tip="{l:T 'Speichert mit 65 536 statt 256 Stufen je Farbe — gegen Treppen in Verläufen, wenn das Bild später weiterbearbeitet wird. Die Datei wird dadurch etwa doppelt so groß. Wirkt nur, wenn am Bild gerechnet wurde (Größe, Regler, Entzerren): ein unbearbeitetes 8-Bit-Foto bleibt gleich groß. Bei kräftiger Tonwert-Bearbeitung (Dunst, Kontrast, Tiefen/Lichter, Helligkeit, Luminanz) setzt die App den Haken nach jeder solchen Änderung selbst – „empfohlen“; herausnehmen geht jederzeit. Bilder, die schon 16 Bit haben, bleiben es auch ohne Haken.'}" />
                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource RecommendBrush}"
                                           Text="{l:T 'empfohlen'}" IsVisible="{Binding HighBitDepthRecommended}"
                                           ToolTip.Tip="{l:T 'Kräftige Tonwert-Bearbeitung: mit 16 Bit bleiben weiche Verläufe auch beim Weiterbearbeiten ohne Treppen. Die Datei wird etwa doppelt so groß.'}" />
                            </StackPanel>
                            <TextBlock Classes="hint" IsVisible="{Binding !QualityApplies}" Margin="0,0,0,2"
                                       Text="{l:T 'Dieses Format speichert immer verlustfrei.'}" />

                            <!-- Echte Schätzung: eine Probe wird im Zielformat kodiert -->
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="{DynamicResource RadiusControl}"
                                    Padding="10,7" Margin="0,8,0,0"
                                    ToolTip.Tip="{l:T 'Berechnet aus einer Probe im Zielformat mit allen Einstellungen. Ohne „≈“ ist es die exakte Größe.'}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="good" Text="{Binding EstimatedSize}" />
                                        <TextBlock Classes="hint" Text="{l:T 'wird berechnet …'}"
                                                   IsVisible="{Binding IsEstimating}" />
                                    </StackPanel>
                                    <TextBlock Classes="hint" Text="{Binding SavingsText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Zuschnitt -->
                    <HeaderedContentControl x:Name="CropGroup" Header="{l:T 'ZUSCHNITT'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Verhältnis'}" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding AspectPresets}"
                                          SelectedItem="{Binding SelectedAspectPreset}" />
                            </Grid>

                            <!-- Noch keine Auswahl: kurze Anleitung -->
                            <Border IsVisible="{Binding !HasCropSelection}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="✂" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Classes="hint"
                                               Text="{l:T 'Mit gedrückter linker Maustaste über das Bild ziehen, um einen Ausschnitt zu wählen.'}" />
                                </Grid>
                            </Border>

                            <!-- Auswahl vorhanden -->
                            <StackPanel IsVisible="{Binding HasCropSelection}">
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto,*">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Position'}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CropX}" Minimum="0" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="," Margin="7,0" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding CropY}" Minimum="0" />
                                </Grid>

                                <Grid Classes="row" ColumnDefinitions="76,*,Auto,*">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Größe'}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CropWidth}" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="×" Margin="7,0" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding CropHeight}" />
                                </Grid>

                                <!-- Runde Ecken: Max = halbe längste Seite → Ellipse bzw. Kreis -->
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Ecken'}" />
                                    <Slider Grid.Column="1" Minimum="0"
                                            Maximum="{Binding MaxCornerRadius}"
                                            Value="{Binding CornerRadius}"
                                            ToolTip.Tip="{l:T 'Rundet die Ecken der Auswahl ab. Ganz rechts wird daraus eine Ellipse — bei Verhältnis 1:1 ein Kreis. Alles außerhalb der Rundung wird beim Zuschneiden transparent.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" MinWidth="50"
                                               Text="{Binding CornerRadiusLabel}" />
                                </Grid>

                                <Border IsVisible="{Binding ShowTransparencyWarning}"
                                        Background="#1FE0A100" BorderBrush="#66E0A100"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusControl}"
                                        Padding="10,7" Margin="0,0,0,10">
                                    <TextBlock Classes="hint"
                                               Text="{l:T 'JPEG und BMP kennen keine Transparenz — die runden Ecken würden weiß. Für Buttons PNG oder WebP wählen.'}" />
                                </Border>

                                <Grid ColumnDefinitions="Auto,8,*">
                                    <Button Grid.Column="0" Classes="subtle"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding ClearSelectionCommand}"
                                            Content="{l:T 'Auswahl aufheben'}"
                                            ToolTip.Tip="{l:T 'Rahmen entfernen, das Bild bleibt unverändert (Esc).'}" />
                                    <Button Grid.Column="2" Classes="primary"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding CropToSelectionCommand}"
                                            Content="{l:T 'Auf Auswahl zuschneiden'}"
                                            ToolTip.Tip="{l:T 'Der Ausschnitt wird zum neuen Bild. Bei runden Ecken wird alles außerhalb der Rundung transparent. Rückgängig mit Strg+Z. Auch per Enter oder Doppelklick in den Rahmen.'}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Größe -->
                    <HeaderedContentControl Header="{l:T 'GRÖSSE'}">
                        <StackPanel>
                            <!-- Einheit: Pixel oder Millimeter (Druckgröße bei der eingestellten DPI) -->
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Einheit'}" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding SizeUnits}"
                                          SelectedItem="{Binding SelectedSizeUnit}"
                                          ToolTip.Tip="{l:T 'Pixel: Bildgröße in Pixeln. mm: Druckgröße in Millimetern — die Pixel ergeben sich aus der DPI. Die Einheit entscheidet auch, was eine neue DPI ändert: bei Pixel nur die Druckgröße, bei mm die Pixel.'}" />
                                <!-- Standardformat: genau über der Kette, gleich groß. Symbol: Blatt mit Eselsohr (eigenes). -->
                                <Button Grid.Column="2" Classes="paper" Margin="8,0,0,0"
                                        ToolTip.Tip="{l:T 'Vielfaches des Bildes (2×, 4×, 16×) oder Standardformat wählen (A4, A5, Fotoabzüge …): Das Bild wird in Millimetern darauf gebracht – Hoch- oder Querformat wie das Bild, bei geschlossener Kette ganz hinein mit gleichem Seitenverhältnis. Die DPI bleibt (für den Druck 300 einstellen), die Pixel folgen.'}">
                                    <Path Data="M 7,3 L 14,3 L 18,7 L 18,21 L 7,21 Z M 14,3 L 14,7 L 18,7 M 9.5,12 L 15.5,12 M 9.5,15.5 L 15.5,15.5" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="{l:T 'Vielfaches des Bildes'}" IsEnabled="False" />
                                            <MenuItem Header="{Binding ScaleTwiceText}" Command="{Binding ApplyScaleFactorCommand}" CommandParameter="2" />
                                            <MenuItem Header="{Binding ScaleFourText}" Command="{Binding ApplyScaleFactorCommand}" CommandParameter="4" />
                                            <MenuItem Header="{Binding ScaleSixteenText}" Command="{Binding ApplyScaleFactorCommand}" CommandParameter="16" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'DIN-Formate'}" IsEnabled="False" />
                                            <MenuItem Header="A0  ·  841 × 1189 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A0" />
                                            <MenuItem Header="A1  ·  594 × 841 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A1" />
                                            <MenuItem Header="A2  ·  420 × 594 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A2" />
                                            <MenuItem Header="A3  ·  297 × 420 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A3" />
                                            <MenuItem Header="A4  ·  210 × 297 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A4" />
                                            <MenuItem Header="A5  ·  148 × 210 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A5" />
                                            <MenuItem Header="A6  ·  105 × 148 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A6" />
                                            <MenuItem Header="A7  ·  74 × 105 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="A7" />
                                            <MenuItem Header="DIN lang  ·  99 × 210 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="DL" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'Fotoabzüge (cm)'}" IsEnabled="False" />
                                            <MenuItem Header="9 × 13  ·  89 × 127 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="9x13" />
                                            <MenuItem Header="10 × 15  ·  102 × 152 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="10x15" />
                                            <MenuItem Header="13 × 18  ·  127 × 178 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="13x18" />
                                            <MenuItem Header="15 × 20  ·  152 × 203 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="15x20" />
                                            <MenuItem Header="20 × 30  ·  203 × 305 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="20x30" />
                                            <MenuItem Header="30 × 45  ·  305 × 457 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="30x45" />
                                            <Separator />
                                            <MenuItem Header="{l:T 'US-Formate'}" IsEnabled="False" />
                                            <MenuItem Header="Letter  ·  216 × 279 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="Letter" />
                                            <MenuItem Header="Legal  ·  216 × 356 mm" Command="{Binding ApplyPaperFormatCommand}" CommandParameter="Legal" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <!-- Breite × Höhe mit Kette: zu = proportional, offen = frei -->
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Maße'}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding FieldWidth}"
                                               FormatString="{Binding SizeFormat}"
                                               Minimum="{Binding SizeMinimum}" Increment="1"
                                               Classes.derived="{Binding KeepAspectRatio}"
                                               Classes.leading="{Binding WidthIsLeading}" />
                                <TextBlock Grid.Column="2" Classes="label" Text="×" Margin="7,0" />
                                <NumericUpDown Grid.Column="3" Value="{Binding FieldHeight}"
                                               FormatString="{Binding SizeFormat}"
                                               Minimum="{Binding SizeMinimum}" Increment="1"
                                               Classes.derived="{Binding KeepAspectRatio}"
                                               Classes.leading="{Binding !WidthIsLeading}" />
                                <ToggleButton Grid.Column="4" Classes="chain" Margin="8,0,0,0"
                                              IsChecked="{Binding KeepAspectRatio}"
                                              ToolTip.Tip="{l:T 'Kette geschlossen: Seitenverhältnis bleibt, die zweite Kante rechnet sich mit. Kette offen: Breite und Höhe frei — das Bild wird gestaucht oder gestreckt.'}">
                                    <Panel Width="24" Height="24">
                                        <!-- Zwei Kettenglieder, um 45° gedreht -->
                                        <Canvas Width="24" Height="24" IsVisible="{Binding KeepAspectRatio}">
                                            <Canvas.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Canvas.RenderTransform>
                                            <Rectangle Canvas.Left="1.5" Canvas.Top="8" Width="12" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource AccentBrush}" />
                                            <Rectangle Canvas.Left="10.5" Canvas.Top="8" Width="12" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource AccentBrush}" />
                                        </Canvas>
                                        <!-- Gebrochen: Glieder auseinander, Bruchstriche dazwischen -->
                                        <Canvas Width="24" Height="24" IsVisible="{Binding !KeepAspectRatio}">
                                            <Canvas.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Canvas.RenderTransform>
                                            <Rectangle Canvas.Left="-1" Canvas.Top="8" Width="10" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource TextMutedBrush}" />
                                            <Rectangle Canvas.Left="15" Canvas.Top="8" Width="10" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource TextMutedBrush}" />
                                            <Line StartPoint="12,2" EndPoint="12,5.5" StrokeThickness="2"
                                                  StrokeLineCap="Round" Stroke="{DynamicResource TextMutedBrush}" />
                                            <Line StartPoint="12,18.5" EndPoint="12,22" StrokeThickness="2"
                                                  StrokeLineCap="Round" Stroke="{DynamicResource TextMutedBrush}" />
                                        </Canvas>
                                    </Panel>
                                </ToggleButton>
                            </Grid>

                            <!-- Im mm-Modus: welche Pixel daraus werden -->
                            <TextBlock Classes="hint" Margin="76,-4,0,8"
                                       IsVisible="{Binding HasPixelEquivalent}"
                                       Text="{Binding PixelEquivalent}" />

                            <!-- DPI: bei Pixel ändert sie nur die Druckgröße, bei mm die Pixel (Einheit entscheidet) -->
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="DPI" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Dpi}"
                                               Minimum="1" Maximum="2400"
                                               ToolTip.Tip="{Binding DpiTip}" />
                                <TextBlock Grid.Column="2" Classes="label" Text="ppi" Margin="7,0,0,0" />
                            </Grid>

                            <!-- Verfahren: oben die schnellen Filter, unter der Linie die KI-Scaler (nur beim Vergrößern) -->
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Verfahren'}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ScaleChoices}"
                                          SelectedItem="{Binding SelectedScaleChoice}"
                                          ToolTip.Tip="{l:T 'Womit die Pixel beim Skalieren entstehen. Die Liste richtet sich nach der Richtung: beim Verkleinern nur Filter, die dafür taugen; beim Vergrößern oben die Filter (sofort), unten die KI-Scaler (Sekunden bis Stunden). Gerechnet wird immer in einem Schritt aus dem Bild selbst.'}">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsSelectable, x:DataType=m:ScaleChoice}" />
                                            <Setter Property="IsVisible" Value="{Binding IsOffered, x:DataType=m:ScaleChoice}" />
                                        </Style>
                                    </ComboBox.Styles>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:ScaleChoice">
                                            <Panel>
                                                <!-- Trennlinie zwischen Filtern und KI-Scalern, nicht wählbar -->
                                                <Border IsVisible="{Binding IsHeader}" Height="1" Margin="0,2"
                                                        Background="{DynamicResource BorderStrongBrush}" />
                                                <Border Background="Transparent" IsVisible="{Binding IsSelectable}">
                                                    <ToolTip.Tip>
                                                        <TextBlock MaxWidth="300" TextWrapping="Wrap" Text="{Binding Description}" />
                                                    </ToolTip.Tip>
                                                    <TextBlock Text="{Binding Name}" />
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBlock Classes="hint" Margin="76,-4,0,6" TextWrapping="Wrap"
                                       Text="{Binding SelectedScaleChoice.Description}" />

                            <CheckBox Margin="76,0,0,8" IsChecked="{Binding GammaCorrect}"
                                      Content="{l:T 'Gamma-korrekt skalieren'}" FontSize="12"
                                      ToolTip.Tip="{l:T 'Rechnet so, wie das Auge Helligkeit wahrnimmt: Feine helle Linien und Kanten werden beim Verkleinern nicht dunkler. Gilt für jedes Umrechnen der Pixel — auch, wenn sich die Pixelzahl durch eine neue DPI ändert. Kostet etwas Zeit, sieht fast immer besser aus.'}" />

                            <!-- KI-Modell fehlt: hier laden (mit allen Teilen), nie still im Hintergrund -->
                            <Button Margin="76,0,0,8" HorizontalAlignment="Left"
                                    IsVisible="{Binding UpscaleModelMissing}"
                                    IsEnabled="{Binding !IsDownloadingUpscaler}"
                                    Content="{Binding UpscaleDownloadText}"
                                    Command="{Binding DownloadUpscalerCommand}"
                                    ToolTip.Tip="{l:T 'Lädt das Modell in den Ordner „KI-Modelle“ neben dem Programm. Verwalten: Einstellungen › KI.'}" />

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto"
                                  IsEnabled="{Binding AiScalerChosen}" ToolTip.ShowOnDisabled="True"
                                  ToolTip.Tip="{l:T 'Nur bei KI-Scalern. Treue-Sicherung: Das Ergebnis wird so nachgeführt, dass es verkleinert wieder genau das Original ergibt. Die KI darf Feines ergänzen, aber Formen, Helligkeit und Farben nicht verschieben. 100 % empfohlen.'}">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Treue'}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                        Value="{Binding UpscaleFidelity}" />
                                <TextBlock Grid.Column="2" Classes="value" Text="{Binding UpscaleFidelityLabel}" />
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto"
                                  IsEnabled="{Binding AiScalerChosen}" ToolTip.ShowOnDisabled="True"
                                  ToolTip.Tip="{l:T 'Nur bei KI-Scalern. Wie viel von der KI kommt: 100 % = nur KI, weniger = gemischt mit dem einfach vergrößerten Bild (Lanczos). Wirkt sofort, ohne neu zu rechnen.'}">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Details'}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                        Value="{Binding UpscaleDetails}" />
                                <TextBlock Grid.Column="2" Classes="value" Text="{Binding UpscaleDetailsLabel}" />
                            </Grid>

                            <TextBlock Classes="hint" Margin="76,-2,0,6" IsVisible="{Binding AiScalerChosen}"
                                       Text="{Binding ComputeDeviceText}" />

                            <Grid ColumnDefinitions="*,8,Auto" Margin="76,2,0,6">
                                <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Content="{Binding ScaleButtonText}"
                                        Command="{Binding UpscaleCommand}"
                                        ToolTip.Tip="{l:T 'Rechnet die Skalierung jetzt in voller Größe und zeigt sie in der Vorschau — zum Hineinzoomen und für Vorher/Nachher. Filter: Sekunden. KI: bei langer Dauer wird gefragt, ob der sichtbare Ausschnitt reicht; fertige Kacheln erscheinen sofort. Speichern geht auch ohne — bei KI wird dann gefragt.'}" />
                                <!-- Zurücksetzen als Symbol, damit „Skalieren (≈ 12 min)“ ganz zu lesen bleibt -->
                                <Button Grid.Column="2" Classes="icon" Content="↺" FontSize="16"
                                        Command="{Binding ResetScaleCommand}"
                                        ToolTip.Tip="{Binding ResetScaleTip}" />
                            </Grid>

                            <TextBlock Classes="hint" Margin="76,0,0,8" TextWrapping="Wrap"
                                       IsVisible="{Binding UpscaleStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Text="{Binding UpscaleStatus}" />

                            <TextBlock Classes="hint" Text="{Binding PrintSize}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Schärfen (wirkt als letzter Schritt, auch auf das KI-Ergebnis) -->
                    <HeaderedContentControl Header="{l:T 'SCHÄRFEN'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Schärfen'}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="3"
                                        Value="{Binding SharpenAmount}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding SharpenLabel}" />
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Radius'}" />
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="5"
                                        Value="{Binding SharpenRadius}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding SharpenRadius, StringFormat='{}{0:F1}'}" />
                            </Grid>

                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Weißabgleich: drei Pipetten, jede allein oder zusammen; mehrere Klicks je Pipette werden gemittelt.
                         Pipetten-Symbol: eigenes. -->
                    <HeaderedContentControl Header="{l:T 'WEISSABGLEICH'}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <ToggleButton Classes="pipette" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              IsChecked="{Binding PickNeutral}" ToolTip.Tip="{l:T 'Neutral: etwas anklicken, das in Wirklichkeit farblos ist (grau oder weiß ohne Farbton) – egal ob hell oder dunkel, z. B. Asphalt, Beton, eine graue Wolke, weißes Papier im Schatten. Nicht: grelles Weiß, fast Schwarzes, Beige oder Holz. Entfernt den Farbstich, die Helligkeit bleibt.'}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M 3,21 L 5.5,21 L 14,12.5 M 3,21 L 3,18.5 L 11.5,10 M 10.5,9 L 15,13.5 M 13.5,11 L 19,5.5 L 18.5,5 L 13,10.5" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                                        <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                Background="{Binding WbNeutralBrush}" IsVisible="{Binding HasWbNeutral}" />
                                        <TextBlock Text="{Binding WbNeutralText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Grid.Column="1" Classes="subtle" Content="×" Margin="4,0,0,0" Padding="8,2"
                                        IsVisible="{Binding HasWbNeutral}"
                                        Command="{Binding ClearPipetteCommand}" CommandParameter="Neutral"
                                        ToolTip.Tip="{l:T 'Messungen dieser Pipette löschen (z. B. nach einem Fehlklick). Strg+Z nimmt nur den letzten Klick zurück.'}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <ToggleButton Classes="pipette" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              IsChecked="{Binding PickBlack}" ToolTip.Tip="{l:T 'Schwarz: die dunkelste Stelle anklicken, die schwarz sein sollte. Korrigiert die Schatten und macht sie satt schwarz.'}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M 3,21 L 5.5,21 L 14,12.5 M 3,21 L 3,18.5 L 11.5,10 M 10.5,9 L 15,13.5 M 13.5,11 L 19,5.5 L 18.5,5 L 13,10.5" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                                        <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                Background="{Binding WbBlackBrush}" IsVisible="{Binding HasWbBlack}" />
                                        <TextBlock Text="{Binding WbBlackText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Grid.Column="1" Classes="subtle" Content="×" Margin="4,0,0,0" Padding="8,2"
                                        IsVisible="{Binding HasWbBlack}"
                                        Command="{Binding ClearPipetteCommand}" CommandParameter="Black"
                                        ToolTip.Tip="{l:T 'Messungen dieser Pipette löschen (z. B. nach einem Fehlklick). Strg+Z nimmt nur den letzten Klick zurück.'}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <ToggleButton Classes="pipette" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                              IsChecked="{Binding PickWhite}" ToolTip.Tip="{l:T 'Weiß: die hellste Stelle anklicken, die weiß sein sollte, aber noch Zeichnung hat. Korrigiert die Lichter und macht sie rein weiß.'}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M 3,21 L 5.5,21 L 14,12.5 M 3,21 L 3,18.5 L 11.5,10 M 10.5,9 L 15,13.5 M 13.5,11 L 19,5.5 L 18.5,5 L 13,10.5" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                                        <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                Background="{Binding WbWhiteBrush}" IsVisible="{Binding HasWbWhite}" />
                                        <TextBlock Text="{Binding WbWhiteText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Grid.Column="1" Classes="subtle" Content="×" Margin="4,0,0,0" Padding="8,2"
                                        IsVisible="{Binding HasWbWhite}"
                                        Command="{Binding ClearPipetteCommand}" CommandParameter="White"
                                        ToolTip.Tip="{l:T 'Messungen dieser Pipette löschen (z. B. nach einem Fehlklick). Strg+Z nimmt nur den letzten Klick zurück.'}" />
                            </Grid>
                            <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding WbHint}" />
                            <Button Classes="subtle" HorizontalAlignment="Left" Margin="0,6,0,0" Content="{l:T 'Zurücksetzen'}"
                                    IsVisible="{Binding HasWhiteBalance}" Command="{Binding ResetWhiteBalanceCommand}"
                                    ToolTip.Tip="{l:T 'Alle drei Pipetten zurücksetzen – der Weißabgleich ist dann aus.'}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    </StackPanel>

                    <!-- ############################## Rubrik KI (eigenes Modul, Ordner Ai/) -->
                    <ai:AiPanel DataContext="{Binding Ai}" IsVisible="{Binding #TabAi.IsChecked}" />
                    <ai:RetouchPanel DataContext="{Binding Retouch}" IsVisible="{Binding #TabRetouch.IsChecked}" />
                    <ai:BackgroundPanel DataContext="{Binding Background}" IsVisible="{Binding #TabBackground.IsChecked}" />

                    <!-- ############################## Rubrik Tools — je Funktion ein Regler -->
                    <StackPanel Spacing="10" IsVisible="{Binding #TabTools.IsChecked}">
                        <!-- Gruppen in der Reihenfolge der Kette: Rauschen → Dunst → Gleiche Farbe (Weißabgleich) → Luminanzmaske → Licht → Farbe → Körnung -->
                        <HeaderedContentControl Header="{l:T 'RAUSCHEN'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Rauschen'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding NoiseReduction}"
                                            ToolTip.Tip="{l:T 'Helligkeitsrauschen (Körnung): glättet nur, was dem gemessenen Rauschen des Fotos entspricht — Kanten, Haare, Augen bleiben. Dunkle, stark rauschende Stellen bekommen mehr, saubere fast nichts. Um 50 % ist für Handyfotos meist gut, 100 % kann Haut glätten.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding NoiseLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Farbrauschen'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ColorNoiseReduction}"
                                            ToolTip.Tip="{l:T 'Bunte Punkte und Flecken: glättet nur die Farbe, an den Kanten der Helligkeit entlang — Schärfe und Helligkeit bleiben. Kleine Werte entfernen die Farbpunkte, große auch größere Farbflecken.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding ColorNoiseLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Dunst mit Feineinstellung: Die Feinregler wirken nur, wenn Dunst
                             entfernt wird; Vorgabe sind 3 sachte Durchläufe (seit 0.4.44).
                             Der ganze Block rechnet bei jeder Reglerbewegung vom Original neu. -->
                        <HeaderedContentControl Header="{l:T 'DUNST'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dunst'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="300" Value="{Binding Dehaze}"
                                            ToolTip.Tip="{l:T 'Rechts: Dunst und Nebel entfernen — ferne Berge, Stadt im Smog, Aufnahmen durchs Fenster bekommen wieder Kontrast und Farbe. Bis 100 so viel, wie physikalisch geschätzt wird, darüber kräftiger (bis 300). Links: Dunst hinzufügen, für eine weiche Stimmung.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeLabel}" />
                                </Grid>
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Durchläufe'}" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DehazePasses}"
                                                ToolTip.Tip="{l:T 'Wie oft der Dunst nacheinander entfernt wird — wie das Auge: Ergebnis ansehen, wieder schätzen. Jeder Durchlauf ist ein sachter Schritt mit Kontrast, Dynamik und Schärfe aus dieser Gruppe; der nächste schätzt den klareren Stand neu. Mehr Durchläufe wirken kräftiger. Vorgabe 3; der Himmel bleibt ab dem zweiten unverändert.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazePassesLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Klarheit'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeClarity}"
                                                ToolTip.Tip="{l:T 'Lokaler Kontrast mit großem Radius, kantentreu — Strukturen in der Ferne treten hervor. Nicht im Himmel.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeClarityLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Kontrast'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeContrast}"
                                                ToolTip.Tip="{l:T 'Sanfte S-Kurve auf der Helligkeit nach dem Entfernen.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeContrastLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dynamik'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeVibrance}"
                                                ToolTip.Tip="{l:T 'Blasse Farben (Ferne) bekommen mehr Buntheit, kräftige kaum. Im Himmel nur wenig.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeVibranceLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Schärfe fein'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeSharpen}"
                                                ToolTip.Tip="{l:T 'Feine Schärfe auf Landschaft und Sonnenstrahlen — Details, die der Dunst verschluckt hat. Im glatten Himmel nur wenig.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeSharpenLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Kanten'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeEdge}"
                                                ToolTip.Tip="{l:T 'Kantenschärfe mit größerem Radius (2 Pixel), je Durchlauf. Vorgabe aus — erst, wenn die feine Schärfe nicht reicht.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeEdgeLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Helligkeit'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeBrightness}"
                                                ToolTip.Tip="{l:T 'Wie weit die Helligkeit großräumig wieder ans Original angeglichen wird. 100: so hell wie vorher; 0: so dunkel, wie die Szene ohne Dunst wäre.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeBrightnessLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Entstufen'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeDeband}"
                                                ToolTip.Tip="{l:T 'Glättet Treppen in weichen Verläufen wie dem Himmel (Debanding): am Original, bevor der Kontrast die 8-Bit-Stufen spreizt, und nach jedem Durchlauf. Kanten und Struktur bleiben. Gerechnet wird ohnehin in 32 Bit, auf 8 Bit gerundet erst am Schluss, mit feinem Korn.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeDebandLabel}" />
                                    </Grid>
                                    <!-- Dunstfarbe: fester Verlauf warm → neutral → kühl hinter durchsichtiger Spur (wie „Farbe“).
                                         Zeigt die Wirkung bei warmem Dunst; bei bläulichem wirkt der Regler umgekehrt — die
                                         Richtung ist so aber sofort verständlich. -->
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dunstfarbe'}" />
                                        <Panel Grid.Column="1">
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                        <GradientStop Offset="0" Color="#D9703F" />
                                                        <GradientStop Offset="0.5" Color="#C8C8C8" />
                                                        <GradientStop Offset="1" Color="#4C7FD0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding DehazeCast}"
                                                    ToolTip.Tip="{l:T 'Wie viel der Farbe des Dunstes aus der Landschaft genommen wird: Smog verliert seinen Gelbstich, ferne Wiesen ihr Blau. Bei 0 bleibt der Farbton wie im Original. Im Abendlicht nimmt viel davon auch Wärme weg.'}">
                                                <Slider.Resources>
                                                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                                </Slider.Resources>
                                            </Slider>
                                        </Panel>
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeCastLabel}" />
                                    </Grid>
                                    <Button Classes="tool" HorizontalAlignment="Right" Content="{l:T 'Vorgaben'}"
                                            Command="{Binding ResetDehazeDetailsCommand}"
                                            ToolTip.Tip="{l:T 'Feineinstellung zurück auf die Vorgaben (3 Durchläufe). Der Dunst-Regler bleibt.'}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- „Gleiche Farbe“ ohne Quellbild -->
                        <HeaderedContentControl Header="{l:T 'GLEICHE FARBE'}">
                            <StackPanel>
                                <!-- Gesamt: das ganze Bild heller/dunkler, gerechnet nach der Bereichs-Luminanz darunter -->
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Gesamt'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding MatchGlobal}"
                                            ToolTip.Tip="{l:T 'Luminanz für das ganze Bild, ohne Bereiche und Masken: macht alles im selben Verhältnis heller oder dunkler, Weiß läuft weich aus. Wirkt nach der Luminanz darunter – erst die Bereiche angleichen, dann das Ganze heller machen.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MatchGlobalLabel}" />
                                </Grid>
                                <Border Height="1" Margin="0,2,0,6" Background="{DynamicResource BorderBrush2}" />
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Luminanz'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="200" Value="{Binding MatchLuminance}"
                                            ToolTip.Tip="{l:T 'Rechnet die Helligkeit hoch statt sie nur anzuheben — das Bild wird leuchtender, die Kontraste bleiben. Weiß läuft weich aus, nichts frisst aus. Über 200 % (bis 300 %) vor allem zusammen mit dem Zielwert: dann erreichen auch tiefe Schatten das Ziel, Mitteltöne bleiben ruhig.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MatchLuminanceLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto" IsEnabled="{Binding CanLimitLuminance}">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Zielwert'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding MatchTarget}"
                                            ToolTip.Tip="{l:T 'Hellt dunkle Bereiche nur bis zu dieser Helligkeit auf: ein dunkler Baum bekommt viel, eine Wiese im Mittelton kaum etwas – so strahlt nichts über. Luminanz bestimmt, wie stark höchstens. Ganz links: aus, alles wird im selben Verhältnis heller. Wirkt nur beim Aufhellen.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MatchTargetLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto" IsEnabled="{Binding CanLimitLuminance}">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Schwellwert'}" />
                                    <Slider Grid.Column="1" Minimum="5" Maximum="100" Value="{Binding MatchLimit}"
                                            ToolTip.Tip="{l:T 'Luminanz hellt nur Bereiche auf, die dunkler sind als dieser Wert – ein dunkler Baum wird als Ganzes heller, der helle Himmel daneben und zwischen den Ästen bleibt. Ganz rechts: keine Grenze. Wirkt nur beim Aufhellen.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MatchLimitLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Ausgleichen'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Neutralize}"
                                            ToolTip.Tip="{l:T 'Entfernt einen Farbstich (z. B. gelbes Kunstlicht, blauer Schatten): Graues und Weißes wird wieder neutral. Der Regler bestimmt, wie viel davon. Kräftige Farben zählen bei der Erkennung nicht mit.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding NeutralizeLabel}" />
                                </Grid>
                                <!-- Farbe: Verlauf kühl → neutral → warm hinter durchsichtiger Spur -->
                                <Grid ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Farbe'}" />
                                    <Panel Grid.Column="1">
                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                    <GradientStop Offset="0" Color="#4C7FD0" />
                                                    <GradientStop Offset="0.5" Color="#C8C8C8" />
                                                    <GradientStop Offset="1" Color="#E0B040" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Warmth}"
                                                ToolTip.Tip="{l:T 'Links kühler (bläulich), rechts wärmer (gelblich), Mitte neutral — z. B. wenn Ausgleichen ein Kunstlicht-Foto zu kühl gemacht hat.'}">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            </Slider.Resources>
                                        </Slider>
                                    </Panel>
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding WarmthLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Luminanzmaske: Dunkles bekommt viel, Mitteltöne anteilig, Helles nichts — pixelgenau.
                             Eigene Gruppe neben „Gleiche Farbe“, lässt sich unabhängig ausschalten oder entfernen. -->
                        <HeaderedContentControl Header="{l:T 'LUMINANZMASKE'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Stärke'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding MaskAmount}"
                                            ToolTip.Tip="{l:T 'Wie viel heller das Dunkelste wird. Mitteltöne bekommen anteilig weniger, helle Bereiche nichts – die Maske folgt jedem Zweig, ohne Hof.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MaskAmountLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Auslaufen'}" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding MaskEnd}"
                                            ToolTip.Tip="{l:T 'Ab dieser Helligkeit passiert nichts mehr – z. B. rund um die Sonne und im hellen Himmel. Darunter wird es zum Dunklen hin immer mehr.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MaskEndLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Verlauf'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MaskCurve}"
                                            ToolTip.Tip="{l:T 'Weich: auch Felder und Himmel bekommen etwas mit. Steil: nur das wirklich Dunkle.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MaskCurveLabel}" />
                                </Grid>
                                <CheckBox Margin="76,0,0,4" IsChecked="{Binding ShowMask}" Content="{l:T 'Maske zeigen'}"
                                          ToolTip.Tip="{l:T 'Zeigt die Maske als Graustufen: weiß bekommt die volle Stärke, schwarz nichts. Nur zum Einstellen – der Export bleibt das Bild.'}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="{l:T 'LICHT'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Helligkeit'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Brightness}"
                                            ToolTip.Tip="{l:T 'Hellt die Mitten auf oder dunkelt sie ab. Schwarz und Weiß bleiben, nichts frisst aus.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding BrightnessLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Kontrast'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}"
                                            ToolTip.Tip="{l:T 'Rechts: Helles heller, Dunkles dunkler — knackiger. Links: weicher, flacher.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding ContrastLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Tiefen'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Shadows}"
                                            ToolTip.Tip="{l:T 'Rechts: dunkle Bereiche aufhellen, z. B. Gesichter im Gegenlicht. Wirkt nur dort, wo die Umgebung dunkel ist — helle Bereiche bleiben.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding ShadowsLabel}" />
                                </Grid>
                                <Grid ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Lichter'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Highlights}"
                                            ToolTip.Tip="{l:T 'Links: helle Bereiche abdunkeln und Zeichnung zurückholen, z. B. im Himmel. Wirkt nur dort, wo die Umgebung hell ist.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding HighlightsLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="{l:T 'FARBE'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dynamik'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Vibrance}"
                                            ToolTip.Tip="{l:T 'Rechts: blasse Farben kräftiger, schon kräftige kaum — Hauttöne bleiben natürlich. Lebendiger als Sättigung, ohne bunt zu wirken.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding VibranceLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Sättigung'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Saturation}"
                                            ToolTip.Tip="{l:T 'Rechts: alle Farben gleich stark kräftiger. Ganz links: Schwarzweiß.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding SaturationLabel}" />
                                </Grid>
                                <Grid ColumnDefinitions="76,*">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Färben'}" />
                                    <ComboBox Classes="tr" Grid.Column="1" ItemsSource="{Binding Tints}" SelectedItem="{Binding SelectedTint}"
                                              ToolTip.Tip="{l:T 'Das ganze Bild in einem Farbton: Schwarzweiß oder eine Farbe nach Wahl — z. B. Sepia wie ein alter Fotoabzug.'}" />
                                </Grid>
                                <!-- Farbton: die Leiste dahinter zeigt den Farbkreis -->
                                <Grid ColumnDefinitions="76,*,Auto" Margin="0,8,0,0" IsVisible="{Binding IsTintColor}">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Farbton'}" />
                                    <Panel Grid.Column="1">
                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                    <GradientStop Offset="0" Color="#B5583F" />
                                                    <GradientStop Offset="0.0833" Color="#B57F3F" />
                                                    <GradientStop Offset="0.1667" Color="#B5A63F" />
                                                    <GradientStop Offset="0.3333" Color="#58B53F" />
                                                    <GradientStop Offset="0.5" Color="#3FB5A6" />
                                                    <GradientStop Offset="0.6667" Color="#3F58B5" />
                                                    <GradientStop Offset="0.8333" Color="#A63FB5" />
                                                    <GradientStop Offset="1" Color="#B5583F" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- Spur durchsichtig, darunter liegt der Farbkreis. Die Ressourcen hier am
                                             Regler, nicht in einem Stil: Stil-Ressourcen gelten in Avalonia für alle
                                             Regler der Anwendung (in 0.4.28 waren dadurch alle Spuren unsichtbar). -->
                                        <Slider Minimum="0" Maximum="360" Value="{Binding TintHue}"
                                                ToolTip.Tip="{l:T 'Farbe der Tönung. Um 30°: Sepia, um 210°: kühles Blau.'}">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            </Slider.Resources>
                                        </Slider>
                                    </Panel>
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding TintHueLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Körnung: immer der letzte Schritt der Kette (nach Schärfen, KI und Haut & Details), deshalb die letzte
                             Gruppe. Unabhängig von der Körnung bei „Haut & Details“. -->
                        <HeaderedContentControl Header="{l:T 'KÖRNUNG'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Stärke'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GrainAmount}"
                                            ToolTip.Tip="{l:T 'Wie viel Korn über das fertige Bild kommt – wie bei Film in den Mitteltönen am meisten, in Schwarz und Weiß fast nichts. Kommt immer zuletzt, nach Schärfen und KI.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding GrainAmountLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Korngröße'}" />
                                    <Slider Grid.Column="1" Minimum="-27" Maximum="100" Value="{Binding GrainSize}"
                                            ToolTip.Tip="{l:T 'Von 0,1 px (feiner als ein Pixel: ohne grobe Häufungen) über 0,25 px (Pixel für Pixel) bis grob. Gilt für die Ausgabegröße – beim Verkleinern sieht das Korn gleich aus.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding GrainSizeLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Rauheit'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GrainRoughness}"
                                            ToolTip.Tip="{l:T 'Gleichmäßig wie ein Sensor oder klumpig wie Film: mischt gröberes Korn dazu und lässt die Stärke großflächig schwanken.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding GrainRoughnessLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Farbanteil'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GrainColor}"
                                            ToolTip.Tip="{l:T 'Aus: reines Helligkeitskorn wie bei Schwarzweißfilm. Mehr: zusätzlich bunte Körnchen, jeder Farbkanal für sich.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding GrainColorLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="88,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Härte'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding GrainHardness}"
                                            ToolTip.Tip="{l:T 'Weich: Körner als sanfte Tupfen. Mehr: scharf begrenzte Körner mit steilen Rändern – das Bild wirkt körniger, bei gleicher Stärke und Größe.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding GrainHardnessLabel}" />
                                </Grid>
                                <Button Classes="subtle" Margin="88,2,0,4" HorizontalAlignment="Left"
                                        Content="{l:T 'Aus dem Foto ermitteln'}" Command="{Binding MeasureGrainCommand}"
                                        ToolTip.Tip="{l:T 'Misst das Korn des Fotos (vor KI und Entrauschen) und stellt Stärke, Korngröße und Farbanteil so ein, dass es wieder so aussieht – sinnvoll nach „Rauschen“ oder KI. Danach lässt sich alles nachbessern; Rückgängig mit Strg+Z.'}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <Button Classes="subtle" HorizontalAlignment="Left" Content="{l:T 'Zurücksetzen'}"
                                Command="{Binding ResetToolsCommand}"
                                ToolTip.Tip="{l:T 'Alle Regler dieser Kachel auf 0, Färben aus. Rückgängig mit Strg+Z.'}" />
                    </StackPanel>

                    <!-- ############################## Rubrik Ausgabe -->
                    <StackPanel Spacing="10" IsVisible="{Binding #TabOutput.IsChecked}">

                    <!-- ============================== Metadaten und Farbe -->
                    <HeaderedContentControl Header="{l:T 'METADATEN &amp; FARBE'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="EXIF" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding MetadataModes}"
                                          ToolTip.Tip="{l:T 'EXIF/IPTC/XMP: Kamera, Datum, Ort, Copyright. „Nur GPS entfernen“ löscht die Ortsangaben — sinnvoll vor dem Teilen im Netz.'}"
                                          SelectedItem="{Binding SelectedMetadataMode}" />
                            </Grid>

                            <Grid ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'ICC-Profil'}" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding ColorModes}"
                                          ToolTip.Tip="{l:T 'Profil behalten: Farbraum wie im Original (z. B. Adobe RGB für den Druck). Nach sRGB: überall richtige Farben — Standard fürs Web. Profil verwerfen: sRGB ohne eingebettetes Profil, etwas kleinere Datei.'}"
                                          SelectedItem="{Binding SelectedColorMode}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Ausgabe -->
                    <HeaderedContentControl Header="{l:T 'AUSGABE'}">
                        <Grid ColumnDefinitions="76,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dateiname'}" />
                            <TextBox Grid.Column="1" Text="{Binding NamePattern}"
                                     FontSize="12"
                                     CornerRadius="{DynamicResource RadiusControl}">
                                <!-- Als Element: die Platzhalter {name} … würden in {l:T …} als Erweiterung gelesen -->
                                <ToolTip.Tip>
                                    <l:T Text="Platzhalter: {name} Dateiname ohne Endung · {breite} {höhe} Pixelmaße · {n} laufende Nummer · {datum} heutiges Datum. Die Endung kommt automatisch dazu." />
                                </ToolTip.Tip>
                            </TextBox>
                        </Grid>
                    </HeaderedContentControl>

                    <!-- ============================== Bildinformationen: was die Originaldatei über sich sagt (nur Anzeige).
                         Unter AUSGABE, damit die Einstellungen oben bleiben; die lange Liste ist zugeklappt und rollt für sich. -->
                    <HeaderedContentControl Header="{l:T 'BILDINFORMATIONEN'}" IsVisible="{Binding HasImage}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="{l:T 'Aus der Originaldatei – Bearbeitungen ändern das nicht. Was beim Speichern übernommen wird, bestimmt „EXIF“ oben.'}" />
                            <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding MetadataNote}"
                                       IsVisible="{Binding MetadataNote, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <ItemsControl ItemsSource="{Binding MetadataGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MetadataGroupView">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Title}" />
                                                <TextBlock Classes="hint" Foreground="#C77700" VerticalAlignment="Center" Text="{Binding RemovedNote}"
                                                           IsVisible="{Binding RemovedNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="meta:MetadataField">
                                                        <Grid ColumnDefinitions="104,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,0,6,0" Text="{Binding Label}" />
                                                            <SelectableTextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding Value}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="{Binding MetadataTagsHeader}" IsVisible="{Binding HasMetadataTags}"
                                      HorizontalAlignment="Stretch" Padding="8,6">
                                <StackPanel Spacing="6">
                                    <Button Classes="subtle" HorizontalAlignment="Left" Content="{l:T 'Alles kopieren'}"
                                            Command="{Binding CopyMetadataCommand}"
                                            ToolTip.Tip="{l:T 'Übersicht und alle Einträge als Text in die Zwischenablage.'}" />
                                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding MetadataTags}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="meta:MetadataTag">
                                                    <Grid ColumnDefinitions="*,*" Margin="0,1">
                                                        <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,0,8,0">
                                                            <Run Text="{Binding Directory}" /><Run Text=" · " /><Run Text="{Binding Name}" />
                                                        </TextBlock>
                                                        <SelectableTextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </HeaderedContentControl>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Trennlinie -->
            <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource BorderBrush2}" />

            <!-- Bildfläche rechts -->
            <DockPanel Grid.Column="3" LastChildFill="True">

                <!-- Werkzeugleiste unter dem Bild -->
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <Button Grid.Column="0" Classes="tool" MinWidth="56"
                                IsVisible="{Binding HasImage}"
                                Click="OnFitToViewClick"
                                Content="{Binding #Crop.DisplayPercent, StringFormat='{}{0} %'}">
                            <ToolTip.Tip>
                                <StackPanel Spacing="4" MaxWidth="280">
                                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Zoom'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Strg + Mausrad über dem Bild zoomt um den Mauszeiger.'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Im Zoom verschieben: Strg + Ziehen; bei ausgeschaltetem Auswahlrahmen auch einfach Ziehen.'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Klick hier oder Strg+0: einpassen · Strg+1: 100 %'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Die Prozente beziehen sich auf das Ergebnis in der eingestellten Größe.'}" />
                                </StackPanel>
                            </ToolTip.Tip>
                        </Button>

                        <Rectangle Grid.Column="1" Width="1" Margin="10,4"
                                   Fill="{DynamicResource BorderBrush2}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Classes="tool" Content="{l:T '↶  Rückgängig'}"
                                    Command="{Binding UndoCommand}"
                                    ToolTip.Tip="{l:T 'Letzten Schritt zurücknehmen (Strg+Z). Nach einem Zuschnitt kommt der Rahmen wieder, zum Nachjustieren.'}" />
                            <Button Classes="tool" Content="{l:T '↷  Wiederholen'}"
                                    Command="{Binding RedoCommand}"
                                    ToolTip.Tip="{l:T 'Zurückgenommenen Schritt erneut ausführen (Strg+Y).'}" />

                            <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource BorderBrush2}" />

                            <Button Classes="icon" Content="⇄" Command="{Binding FlipHorizontalCommand}"
                                    ToolTip.Tip="{l:T 'Waagerecht spiegeln (links ↔ rechts). Rückgängig mit Strg+Z.'}" />
                        </StackPanel>

                        <ToggleButton Grid.Column="4" Classes="chain" Width="NaN" Padding="12,5"
                                      IsChecked="{Binding ShowOriginal}"
                                      IsEnabled="{Binding CanCompare}"
                                      Content="{l:T '◧  Vorher / Nachher'}" FontSize="12"
                                      ToolTip.Tip="{l:T 'Vergleich mit Trennlinie: links Vorher — das Bild vor den KI-Schritten, ohne Größe, Entrauschen, Tools und Schärfe —, rechts das Ergebnis, so wie es exportiert wird. Die Linie mit der Maus über das Bild ziehen. Zoom und Ausschnitt bleiben gleich.'}" />
                    </Grid>
                </Border>

                <!-- Leinwand: Auswahlrahmen erscheint erst beim Aufziehen -->
                <Border Background="{DynamicResource CanvasBrush}">
                    <Grid>
                        <c:CropView x:Name="Crop"
                                    IsVisible="{Binding HasImage}"
                                    Source="{Binding DisplayBitmap}"
                                    RedrawToken="{Binding RedrawToken}"
                                    CompareSource="{Binding CompareBitmap}"
                                    BeforeLabel="{l:T 'Vorher'}"
                                    AfterLabel="{l:T 'Nachher'}"
                                    DocumentSize="{Binding DocumentSize}"
                                    OutputSize="{Binding ViewOutputSize}"
                                    ViewResetToken="{Binding ViewResetToken}"
                                    Selection="{Binding CropSelection}"
                                    AspectRatio="{Binding AspectRatio}"
                                    SelectionRadius="{Binding CornerRadius}"
                                    RotationAngle="{Binding RotationAngle}"
                                    Quad="{Binding PerspectiveQuad}"
                                    WarpLines="{Binding DewarpLines}"
                                    DrawLines="{Binding DewarpDrawing}"
                                    PickActive="{Binding IsPicking}"
                                    PickCommand="{Binding PickAtCommand}"
                                    PickMarkers="{Binding WbMarkers}"
                                    BrushActive="{Binding ActiveBrush.IsBrushing}"
                                    BrushSize="{Binding ActiveBrush.BrushSize}"
                                    BrushStrokes="{Binding ActiveBrush.Strokes}"
                                    BrushDim="{Binding ActiveBrush.StrokesApplied}"
                                    BrushKeep="{Binding ActiveBrush.BrushKeep}"
                                    BrushHardness="{Binding ActiveBrush.StrokeHardness}"
                                    BrushStrength="{Binding ActiveBrush.StrokeStrength}"
                                    BrushCommand="{Binding ActiveBrush.AddStrokeCommand}"
                                    CropCommand="{Binding CropToSelectionCommand}"
                                    GestureCompletedCommand="{Binding CommitSettingsStepCommand}"
                                    SelectionEnabled="{Binding SelectionActive}" />

                        <!-- Leerer Zustand: große Drop-Zone -->
                        <Grid IsVisible="{Binding !HasImage}"
                              Margin="40" MaxWidth="560" MaxHeight="360">
                            <Rectangle RadiusX="16" RadiusY="16"
                                       Fill="{DynamicResource SurfaceBrush}"
                                       Stroke="{DynamicResource BorderStrongBrush}"
                                       StrokeThickness="2" StrokeDashArray="4,3" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="🖼" FontSize="44" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{l:T 'Bilder hierher ziehen'}" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="{l:T 'Einzelne Bilder, mehrere auf einmal oder einen ganzen Ordner.'}" />
                                <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="{Binding SupportedFormatsSummary}" />
                                <Button Classes="primary" HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Content="{l:T 'Bilder auswählen…'}" Click="OnOpenFilesClick" />
                            </StackPanel>
                        </Grid>

                        <!-- Drehen: gebogene Pfeile oben in den Ecken der Vorschau.
                             Pfadform nach den Lucide-Icons rotate-ccw/rotate-cw (ISC-Lizenz). -->
                        <Button Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding HasImage}"
                                Command="{Binding RotateLeftCommand}"
                                ToolTip.Tip="{l:T '90° nach links drehen (gegen den Uhrzeigersinn). Rückgängig mit Strg+Z.'}">
                            <Path Data="M 3,12 A 9,9 0 1 0 12,3 A 9.75,9.75 0 0 0 5.26,5.74 L 3,8 M 3,3 L 3,8 L 8,8" />
                        </Button>
                        <Button Classes="corner" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsVisible="{Binding HasImage}"
                                Command="{Binding RotateRightCommand}"
                                ToolTip.Tip="{l:T '90° nach rechts drehen (im Uhrzeigersinn). Rückgängig mit Strg+Z.'}">
                            <Path Data="M 21,12 A 9,9 0 1 1 12,3 A 9.75,9.75 0 0 1 18.74,5.74 L 21,8 M 21,3 L 21,8 L 16,8" />
                        </Button>

                        <!-- Auswahlwerkzeug: an (blau) = Ziehen zieht einen Ausschnitt auf, aus = Ziehen verschiebt
                             das Bild. Strg + Ziehen verschiebt immer. Symbol nach Lucide square-dashed (ISC-Lizenz). -->
                        <ToggleButton Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="58,12,12,12"
                                      IsVisible="{Binding HasImage}"
                                      IsChecked="{Binding SelectionTool}"
                                      ToolTip.Tip="{l:T 'Auswahlrahmen: an (blau) — mit der Maus einen Ausschnitt aufziehen, Enter schneidet zu, Esc hebt auf. Aus — Ziehen verschiebt das Bild. Strg + Ziehen verschiebt immer, Strg + Mausrad zoomt.'}">
                            <Path Data="M 5,3 A 2,2 0 0 0 3,5 M 9,3 L 10,3 M 14,3 L 15,3 M 19,3 A 2,2 0 0 1 21,5 M 21,9 L 21,10 M 21,14 L 21,15 M 21,19 A 2,2 0 0 1 19,21 M 14,21 L 15,21 M 9,21 L 10,21 M 5,21 A 2,2 0 0 1 3,19 M 3,14 L 3,15 M 3,9 L 3,10" />
                        </ToggleButton>

                        <!-- Frei drehen: Regler unten, der Rahmen passt sich dem Winkel an. Symbol: Winkel mit Bogen (eigenes,
                             Bogen als Kurve statt „A“ — mit A ragte das Symbol über den runden Knopf). -->
                        <ToggleButton Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="104,12,12,12"
                                      IsVisible="{Binding HasImage}"
                                      IsChecked="{Binding RotationTool}" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="{l:T 'Frei drehen: mit dem Regler unten um einen beliebigen Winkel drehen, z. B. den Horizont gerade richten. Der Rahmen zeigt, was übrig bleibt – er passt sich beim Drehen an und lässt sich danach verschieben und verkleinern. „Drehen und zuschneiden“ übernimmt, Esc verwirft.'}">
                            <Path Data="M 4,18 L 20,18 M 4,18 L 14.5,6 M 10,18 Q 10,15.3 7.95,13.5" />
                        </ToggleButton>

                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="12" Padding="14,8,10,8" CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                IsVisible="{Binding RotationTool}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:T 'Drehen'}" />
                                <Slider Width="340" VerticalAlignment="Center"
                                        Minimum="-180" Maximum="180" SmallChange="0.1" LargeChange="1"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Value="{Binding RotationAngle}"
                                        ToolTip.Tip="{l:T 'Drehwinkel in Grad, positiv im Uhrzeigersinn. Pfeiltasten: 0,1°, Bild auf/ab: 1°.'}" />
                                <NumericUpDown Width="84" VerticalAlignment="Center" ShowButtonSpinner="False"
                                               Minimum="-180" Maximum="180" Increment="0.1" FormatString="0.0"
                                               HorizontalContentAlignment="Right"
                                               Value="{Binding RotationAngle}" />
                                <TextBlock VerticalAlignment="Center" Text="°" />
                                <Button Classes="subtle" VerticalAlignment="Center" Content="0°"
                                        Command="{Binding DiscardRotationCommand}"
                                        ToolTip.Tip="{l:T 'Drehung verwerfen (Esc)'}" />
                                <Button Classes="primary" VerticalAlignment="Center"
                                        Content="{l:T 'Drehen und zuschneiden'}"
                                        Command="{Binding CropToSelectionCommand}"
                                        ToolTip.Tip="{l:T 'Dreht das Bild und schneidet es auf den Rahmen zu – ein Schritt, Strg+Z macht ihn rückgängig. Auch mit Enter oder Doppelklick in den Rahmen.'}" />
                            </StackPanel>
                        </Border>

                        <!-- Entzerren: Rahmen mit frei verschiebbaren Ecken. Symbol: schräges Viereck mit Eckpunkten (eigenes). -->
                        <ToggleButton Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="150,12,12,12"
                                      IsVisible="{Binding HasImage}"
                                      IsChecked="{Binding PerspectiveTool}" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="{l:T 'Entzerren: die vier Ecken des Rahmens auf die Ecken von etwas legen, das in Wirklichkeit rechteckig ist – Blatt, Bild an der Wand, Fenster, Hausfront. Daraus wird ein gerades Rechteck, genau der Inhalt des Rahmens. Beim Ziehen hilft eine Lupe; Pfeiltasten verschieben die zuletzt gezogene Ecke um 1 px (Umschalt: 10 px).'}">
                            <Path Data="M 7,5 L 18,7 L 21,19 L 3,18 Z M 7,4 L 7,6 M 18,6 L 18,8 M 21,18 L 21,20 M 3,17 L 3,19" />
                        </ToggleButton>

                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="12" Padding="14,8,10,8" CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                IsVisible="{Binding PerspectiveTool}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:T 'Entzerren'}" />
                                <TextBlock VerticalAlignment="Center" MinWidth="170" Text="{Binding PerspectiveInfo}" />
                                <Button Classes="subtle" VerticalAlignment="Center" Content="{l:T 'Zurücksetzen'}"
                                        Command="{Binding ResetPerspectiveQuadCommand}" />
                                <Button Classes="primary" VerticalAlignment="Center"
                                        Content="{l:T 'Entzerren und zuschneiden'}"
                                        Command="{Binding CropToSelectionCommand}"
                                        ToolTip.Tip="{l:T 'Macht aus dem Rahmen ein gerades Rechteck – ein Schritt, Strg+Z macht ihn rückgängig. Auch mit Enter oder Doppelklick in den Rahmen; Esc bricht ab.'}" />
                            </StackPanel>
                        </Border>

                        <!-- Rahmen um die zwei Begradigungen (mit Linien, mit KI): sie gehören zusammen -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="190,6,12,12"
                                Width="96" Height="50" CornerRadius="12"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                IsHitTestVisible="False"
                                IsVisible="{Binding HasImage}" />

                        <!-- Gewölbtes Blatt: Linien nachzeichnen, die in Wirklichkeit gerade sind. Symbol: Blatt mit gewölbten
                             Kanten und einer Linie mit Punkten (eigenes). -->
                        <ToggleButton Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="196,12,12,12"
                                      IsVisible="{Binding HasImage}"
                                      IsChecked="{Binding DewarpTool}" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="{l:T 'Gewölbtes Blatt gerade ziehen: Punkte auf Linien setzen, die in Wirklichkeit gerade sind – Textzeilen, Blattkanten, Tabellenlinien, bei Büchern der Falz. Daraus wird das Blatt geglättet und das Seitenverhältnis berechnet; das ganze Bild bleibt. Beim Ziehen hilft eine Lupe. Ein Punkt am Symbol: Linien sind schon verwendet – ein Klick öffnet sie zum Justieren.'}">
                            <Path Data="M 4,5 Q 12,8 20,5 L 20,19 Q 12,22 4,19 Z M 7,12 Q 12,14.5 17,12 M 7,11.2 L 7,12.8 M 12,12.6 L 12,14.2 M 17,11.2 L 17,12.8" />
                        </ToggleButton>

                        <!-- Punkt am Symbol: im Bild steckt eine Begradigung mit Linien — ein Klick öffnet sie zum Justieren -->
                        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top" Margin="223,13,0,0" Width="9" Height="9"
                                 Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.5"
                                 IsHitTestVisible="False" IsVisible="{Binding HasAppliedDewarpLines}" />

                        <!-- KI begradigen: SyntheticDoc rechnet das Blatt mit einem Klick gerade, ohne Linien. Symbol: dasselbe
                             Blatt mit einem Funken (eigenes). Gedrückt, solange die KI-Begradigung im Rezept ist; ein zweiter
                             Klick nimmt sie heraus. -->
                        <ToggleButton Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Margin="242,12,12,12"
                                      IsVisible="{Binding HasImage}"
                                      IsChecked="{Binding AiStraightenActive, Mode=OneWay}"
                                      Command="{Binding StraightenWithAiCommand}"
                                      ToolTip.Tip="{l:T 'KI begradigen: ein Klick, keine Linien – das Modell SyntheticDoc zieht das fotografierte Blatt gerade. Gut bei zerknitterten Blättern, Bons in der Hand und Büchern; bei glatten Arbeitsblättern ist „Gewölbtes Blatt“ mit Linien genauer. Ein zweiter Klick nimmt die Begradigung wieder heraus. Rechtsklick: Schatten entfernen ein oder aus. Braucht das Modell SyntheticDoc (Tab KI).'}">
                            <ToggleButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T 'Schatten entfernen'}" ToggleType="CheckBox"
                                              IsChecked="{Binding AiRemoveShadows}" />
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                            <Path Data="M 4,5 Q 12,8 20,5 L 20,19 Q 12,22 4,19 Z M 12,9 L 13.1,12.4 L 16.5,13.5 L 13.1,14.6 L 12,18 L 10.9,14.6 L 7.5,13.5 L 10.9,12.4 Z" />
                        </ToggleButton>

                        <!-- Feld zum Werkzeug, kompakt, damit es auch im kleinen Fenster ganz zu sehen ist: die Bedienung steht
                             hinter dem „?“, die Knöpfe sind klein und brechen bei Platzmangel in die nächste Zeile um. Seitlich
                             58 px frei: rechts unten liegt das Symbol „Bearbeitungen“ -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="58,12" Padding="10,6,8,6" CornerRadius="12" MaxWidth="560"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                IsVisible="{Binding DewarpTool}">
                            <Panel>
                            <!-- nach „Gerade ziehen“: das Ergebnis, „Justieren“ holt Original und Linien zurück -->
                            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding DewarpShowsResult}">
                                <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center" Margin="2,0,8,0"
                                           Text="{l:T 'Gewölbtes Blatt'}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding DewarpResultInfo}" />
                                <Button Grid.Column="2" Classes="primary compact" Margin="8,0,0,0"
                                        Content="{l:T 'Justieren'}" Command="{Binding AdjustDewarpCommand}"
                                        ToolTip.Tip="{l:T 'Wieder das Original mit den verwendeten Linien zeigen – nacharbeiten und noch einmal gerade ziehen (ersetzt die bisherige Begradigung). Verlassen über das Symbol oben.'}" />
                            </Grid>
                            <StackPanel Spacing="4" IsVisible="{Binding !DewarpShowsResult}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center" Margin="2,0,8,0"
                                               Text="{l:T 'Gewölbtes Blatt'}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding DewarpInfo}" />
                                    <Button Grid.Column="2" Classes="icon" Width="22" Height="22" FontSize="12" Margin="6,0,0,0"
                                            VerticalAlignment="Center" Content="?"
                                            ToolTip.Tip="{l:T 'Ziehen verschiebt das Bild, Ziehen an einem Punkt den Punkt. Klick auf eine Linie: an ihr weiterzeichnen (am näheren Ende). „Zeichnen“: jeder Klick setzt einen Punkt, Enter oder Doppelklick beginnt die nächste Linie, Esc beendet das Zeichnen. Blau: waagerecht auf dem Blatt, orange: senkrecht, pink: Falz – Rechtsklick wechselt. Das × an einer Linie entfernt sie; gestrichelt = Vorschlag, eine Änderung macht ihn zur eigenen Linie. Verlassen über das Symbol oben.'}" />
                                </Grid>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Classes="subtle compact" Content="{l:T 'Vorschlagen'}"
                                            Command="{Binding SuggestDewarpLinesCommand}"
                                            ToolTip.Tip="{l:T 'Sucht Textzeilen, Blattkanten und den Falz und legt sie gestrichelt über das Bild. Eigene und geänderte Linien bleiben; was schon auf einer eigenen Linie liegt, wird nicht noch einmal vorgeschlagen.'}" />
                                    <Button Classes="subtle compact" Content="{l:T 'Vorschläge weg'}"
                                            IsVisible="{Binding HasDewarpSuggestions}"
                                            Command="{Binding DiscardDewarpSuggestionsCommand}"
                                            ToolTip.Tip="{l:T 'Alle unberührten Vorschläge entfernen. Eigene und geänderte Linien bleiben.'}" />
                                    <ToggleButton Classes="subtle compact" Content="{l:T 'Zeichnen'}"
                                            IsChecked="{Binding DewarpDrawing}"
                                            ToolTip.Tip="{l:T 'Zeichnen: jeder Klick setzt einen Punkt, Enter oder Doppelklick beginnt die nächste Linie, Esc beendet das Zeichnen (auch mit N einschalten). Aus: Ziehen verschiebt das Bild, Ziehen an einem Punkt den Punkt.'}" />
                                    <Button Classes="subtle compact" Content="{l:T 'Zurücksetzen'}"
                                            Command="{Binding ResetDewarpLinesCommand}"
                                            ToolTip.Tip="{l:T 'Alle Linien entfernen. Übernommen wird erst mit „Gerade ziehen“.'}" />
                                    <Button Classes="primary compact"
                                            Content="{l:T 'Gerade ziehen'}"
                                            Command="{Binding CropToSelectionCommand}"
                                            ToolTip.Tip="{l:T 'Zieht das Blatt gerade und schneidet auf das größte volle Rechteck zu – ein Schritt, Strg+Z macht ihn rückgängig. Auch mit Enter (ohne aktive Linie).'}" />
                                </WrapPanel>
                            </StackPanel>
                            </Panel>
                        </Border>

                        <!-- Ladeanzeige -->
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                     VerticalAlignment="Top" Height="3" MinHeight="3"
                                     CornerRadius="0" />

                        <!-- Liste „Bearbeitungen“: je Bearbeitung eine Zeile in Rechen-Reihenfolge, das Auge blendet sie
                             aus „Nachher“ und dem Export aus. Symbol nach Lucide layers (ISC-Lizenz). -->
                        <ToggleButton Classes="corner" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                                      IsVisible="{Binding HasImage}"
                                      IsChecked="{Binding ShowEditList}"
                                      ToolTip.Tip="{l:T 'Bearbeitungen: alle Funktionen, die an diesem Bild wirken. Mit dem Auge eine Funktion aus „Nachher“ und dem Export ausschalten.'}">
                            <Path Data="M 12,2 L 2,7 L 12,12 L 22,7 Z M 2,12 L 12,17 L 22,12 M 2,17 L 12,22 L 22,17" />
                        </ToggleButton>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="12,12,12,62" Padding="12,10" Width="330" CornerRadius="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                IsVisible="{Binding ShowEditList}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" FontWeight="SemiBold" Text="{l:T 'BEARBEITUNGEN'}" />
                                <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasEditRows}"
                                           Text="{l:T 'Noch keine Bearbeitungen an diesem Bild.'}" />
                                <!-- höchstens neun Zeilen (je Funktion eine); bei kleinem Fenster scrollen statt abschneiden -->
                                <ScrollViewer MaxHeight="330"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EditRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EditRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                <!-- Auge: offen = fließt in Nachher und Export ein. Lucide eye / eye-off (ISC). -->
                                                <ToggleButton Grid.Column="0" Classes="eye" VerticalAlignment="Center"
                                                              IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}"
                                                              ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Note}">
                                                    <Panel>
                                                        <Path IsVisible="{Binding Shown}"
                                                              Data="M 2,12 C 4.5,6.5 19.5,6.5 22,12 C 19.5,17.5 4.5,17.5 2,12 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 1 0 12,9 Z" />
                                                        <Path IsVisible="{Binding !Shown}"
                                                              Data="M 2,12 C 4.5,6.5 19.5,6.5 22,12 C 19.5,17.5 4.5,17.5 2,12 Z M 3,3 L 21,21" />
                                                    </Panel>
                                                </ToggleButton>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="hint" FontSize="11" Text="{Binding Detail}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <!-- Stift: die Bearbeitung wieder öffnen (Gewölbtes Blatt: Linien justieren). Lucide pencil (ISC). -->
                                                <Button Grid.Column="2" Classes="icon" Width="26" Height="26" Margin="6,0,0,0"
                                                        VerticalAlignment="Center" IsVisible="{Binding CanEdit}"
                                                        Command="{Binding Edit}"
                                                        ToolTip.Tip="{l:T 'Bearbeiten: die verwendeten Linien wieder öffnen und justieren'}">
                                                    <Path Data="M 17,3 A 2.85,2.83 0 1 1 21,7 L 7.5,20.5 L 2,22 L 3.5,16.5 Z M 15,5 L 19,9"
                                                          Width="14" Height="14" Stretch="Uniform" StrokeThickness="2"
                                                          StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{DynamicResource TextBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        IsVisible="{Binding HasEditRows}"
                                        Content="{l:T 'Neu anwenden'}" Command="{Binding ApplySelectionCommand}"
                                        ToolTip.Tip="{l:T 'Nur die eingeschalteten Funktionen festschreiben: ausgeschaltete Regler gehen auf null, eine ausgeschaltete KI oder Haut &amp; Details kommen aus dem Bild. Rückgängig mit Strg+Z.'}" />
                                <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasEditRows}"
                                           Text="{l:T 'Ausgeschaltete Funktionen fehlen in „Nachher“ und im Export. Entzerren, Gerade richten, Zuschnitt und Drehen rechnen immer aus dem Original – jede Stufe lässt sich einzeln ausschalten.'}" />
                            </StackPanel>
                        </Border>

                        <!-- Eine Anzeige für alles, was rechnet: KI, Einstellungen ins Bild, Vorschau (sobald sie
                             spürbar dauert) — Text, Balken, bei der KI auch Abbrechen -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="12" Padding="14,7,10,7" CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                IsVisible="{Binding ShowOverlay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Spacing="5" VerticalAlignment="Center" MinWidth="240">
                                    <TextBlock Classes="hint" Text="{Binding OverlayText}" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverlayProgress}"
                                                 Height="4" MinHeight="4" IsVisible="{Binding OverlayHasProgress}" />
                                </StackPanel>
                                <Button Classes="subtle" VerticalAlignment="Center" Content="{l:T 'Abbrechen'}"
                                        Command="{Binding ActivityCancel}" IsVisible="{Binding OverlayCanCancel}" />
                            </StackPanel>
                        </Border>

                        <!-- Wird beim Hineinziehen von Dateien eingeblendet -->
                        <Grid x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
                              Margin="12" Opacity="0.95">
                            <Rectangle RadiusX="14" RadiusY="14"
                                       Fill="{DynamicResource AccentSoftBrush}"
                                       Stroke="{DynamicResource AccentBrush}"
                                       StrokeThickness="2" StrokeDashArray="4,3" />
                            <TextBlock Text="{l:T 'Loslassen zum Öffnen'}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
