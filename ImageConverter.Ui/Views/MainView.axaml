<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImageConverter.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImageConverter.ViewModels"
             xmlns:m="using:ImageConverter.Models"
             xmlns:c="using:ImageConverter.Controls"
             xmlns:ai="using:ImageConverter.Ai"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="ImageConverter.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ============================================================ -->
        <!-- Kopfleiste: Dateien                                          -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Classes="subtle" Content="{l:T '＋  Bilder'}"
                        Click="OnOpenFilesClick"
                        ToolTip.Tip="{l:T 'Bilder oder ganze Ordner öffnen — oder einfach ins Fenster ziehen.'}" />

                <!-- Blättern, wenn mehrere Bilder geladen sind -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="10,0,0,0"
                            IsVisible="{Binding HasMultipleFiles}">
                    <Button Classes="icon" Content="‹" FontSize="18"
                            Command="{Binding PreviousFileCommand}" ToolTip.Tip="{l:T 'Vorheriges Bild'}" />
                    <TextBlock Classes="label" Text="{Binding FilePosition}" Margin="4,0" />
                    <Button Classes="icon" Content="›" FontSize="18"
                            Command="{Binding NextFileCommand}" ToolTip.Tip="{l:T 'Nächstes Bild'}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="14,0,0,0" Spacing="1">
                    <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Classes="hint" Text="{Binding FileDetails}" />
                </StackPanel>

                <!-- Fehlermeldung, z. B. bei nicht unterstütztem Format -->
                <Border Grid.Column="3" HorizontalAlignment="Center" Margin="16,0"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#1FE0A100" BorderBrush="#66E0A100" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}" Padding="10,5">
                    <TextBlock Classes="hint" Text="{Binding ErrorMessage}" MaxWidth="460" />
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <Button Classes="icon" Content="☰" ToolTip.Tip="{l:T 'Einstellungen (KI-Modelle, Sprache)'}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Classes="icon" Content="?" ToolTip.Tip="{l:T 'Hilfe'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Fußleiste: Ziel, Export                                      -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <!-- Ergebnis des letzten Exports -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="good" Text="✓" FontSize="14" />
                    <TextBlock Classes="hint" FontSize="12" Text="{Binding StatusMessage}" />
                    <Button Classes="tool" Content="{l:T 'Ordner öffnen'}" Click="OnOpenExportFolderClick"
                            IsVisible="{Binding LastExportFolder, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="160"
                             HorizontalAlignment="Left" IsVisible="{Binding IsExporting}" />

                <TextBlock Grid.Column="1" Classes="label" Margin="0,0,8,0" Text="{l:T 'Ziel'}" />

                <!-- Zielordner: Klick wählt einen Ordner, ✕ setzt auf „neben dem Original" zurück -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tool" Click="OnChooseOutputFolderClick" Padding="10,0"
                                ToolTip.Tip="{l:T 'Zielordner wählen. Ohne Auswahl landet das Ergebnis im Unterordner „konvertiert“ neben dem Original.'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding OutputFolderDisplay}" FontSize="12" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="label" Text="…" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Content="✕" Padding="8,0"
                                IsVisible="{Binding HasCustomOutputFolder}"
                                Command="{Binding ResetOutputFolderCommand}"
                                ToolTip.Tip="{l:T 'Zurück zu: neben dem Original › konvertiert'}" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" Classes="subtle" Content="{l:T 'Drucken …'}" Margin="0,0,8,0"
                        Command="{Binding PrintCommand}"
                        ToolTip.Tip="{l:T 'Drucken oder als PDF speichern — mehrere Bilder pro Seite, mit Abstand zum Ausschneiden (Strg+P).'}" />

                <Button Grid.Column="4" Classes="primary" Content="{l:T 'Exportieren'}"
                        Command="{Binding ExportCommand}"
                        ToolTip.Tip="{l:T 'Mit allen Einstellungen in voller Auflösung speichern. Vorhandene Dateien werden nie überschrieben.'}" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Hauptbereich: Einstellungen links, Bild rechts               -->
        <!-- ============================================================ -->
        <Grid ColumnDefinitions="Auto,352,Auto,*">

            <!-- Kachelleiste ganz links: wählt die Rubrik. Zugeklappt nur Icons, aufgeklappt
                 mit Name und Inhalt. Icons nach Lucide (ISC-Lizenz), 24er-Raster. -->
            <Border Grid.Column="0" Classes="rail">
                <DockPanel>
                    <ToggleButton x:Name="RailExpand" DockPanel.Dock="Bottom" Classes="railToggle"
                                  ToolTip.Tip="{l:T 'Leiste aufklappen: zeigt, was in jeder Rubrik steckt'}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 6,17 L 11,12 L 6,7 M 13,17 L 18,12 L 13,7" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <StackPanel Spacing="4">
                        <RadioButton x:Name="TabStandard" Classes="tile" GroupName="rubrik" IsChecked="True"
                                     ToolTip.Tip="{l:T 'Standard: Format · Zuschnitt · Größe · DPI · Schärfen'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 5,3 H 19 A 2,2 0 0 1 21,5 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 5 A 2,2 0 0 1 5,3 Z M 7,9 A 2,2 0 1 0 11,9 A 2,2 0 1 0 7,9 Z M 21,15 L 17.9,11.9 A 2,2 0 0 0 15.1,11.9 L 6,21" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Standard'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Format · Zuschnitt · Größe · DPI · Schärfen'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabAi" Classes="tile" GroupName="rubrik"
                                     ToolTip.Tip="{l:T 'KI: Bilder vergrößern und verbessern, Gesichter wiederherstellen'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,3 L 10.1,8.8 A 2,2 0 0 1 8.8,10.1 L 3,12 L 8.8,13.9 A 2,2 0 0 1 10.1,15.2 L 12,21 L 13.9,15.2 A 2,2 0 0 1 15.2,13.9 L 21,12 L 15.2,10.1 A 2,2 0 0 1 13.9,8.8 Z M 5,3 V 7 M 3,5 H 7 M 19,17 V 21 M 17,19 H 21" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'KI'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Vergrößern · Verbessern · Gesichter'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabTools" Classes="tile" GroupName="rubrik"
                                     ToolTip.Tip="{l:T 'Tools: Helligkeit · Kontrast · Tiefen · Lichter · Dunst · Dynamik · Sättigung · Färben · Gleiche Farbe'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 21,4 H 14 M 10,4 H 3 M 21,12 H 12 M 8,12 H 3 M 21,20 H 16 M 12,20 H 3 M 14,2 V 6 M 8,10 V 14 M 16,18 V 22" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Tools'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Helligkeit · Kontrast · Tiefen · Lichter · Dunst · Dynamik · Sättigung · Färben · Gleiche Farbe'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="TabOutput" Classes="tile" GroupName="rubrik"
                                     ToolTip.Tip="{l:T 'Ausgabe: Metadaten · Farbprofil · Dateiname'}">
                            <Grid ColumnDefinitions="40,Auto">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 15,2 H 6 A 2,2 0 0 0 4,4 V 20 A 2,2 0 0 0 6,22 H 18 A 2,2 0 0 0 20,20 V 7 Z M 14,2 V 6 A 2,2 0 0 0 16,8 H 20 M 10,9 H 8 M 16,13 H 8 M 16,17 H 8" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" IsVisible="{Binding #RailExpand.IsChecked}">
                                    <TextBlock Classes="tileName" Text="{l:T 'Ausgabe'}" />
                                    <TextBlock Classes="tileHint" Text="{l:T 'Metadaten · Farbprofil · Dateiname'}" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Einstellungen der gewählten Rubrik -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,12,8,12"
                          Classes="settings">
                <StackPanel Spacing="10">

                    <!-- ============================== Für alle / einzeln -->
                    <Border IsVisible="{Binding HasMultipleFiles}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="12,6">
                        <StackPanel Spacing="2">
                            <CheckBox IsChecked="{Binding ApplyToAll}"
                                      Content="{l:T 'Gleiche Einstellungen für alle Bilder'}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="300" Spacing="6">
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{l:T 'Haken gesetzt: alle Bilder teilen sich die Einstellungen.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Die Größe wird pro Bild umgerechnet: Die eingegebene Kante gilt, die andere folgt dem Seitenverhältnis des Bildes — nichts wird verzerrt.'}" />
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{l:T 'Haken entfernt: jedes Bild bekommt eigene Einstellungen.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Haken wieder setzen: alle Bilder übernehmen die Einstellungen des aktuellen Bildes.'}" />
                                        <TextBlock TextWrapping="Wrap" Text="{l:T 'Zuschnitt und Drehen gelten immer nur für das einzelne Bild.'}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                            </CheckBox>
                            <TextBlock Classes="hint" Margin="28,0,0,2"
                                       IsVisible="{Binding !ApplyToAll}"
                                       Text="{l:T 'Einstellungen gelten nur für dieses Bild.'}" />
                        </StackPanel>
                    </Border>

                    <!-- ############################## Rubrik Standard -->
                    <StackPanel Spacing="10" IsVisible="{Binding #TabStandard.IsChecked}">

                    <!-- ============================== Format -->
                    <HeaderedContentControl Header="{l:T 'FORMAT'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Format'}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Formats}"
                                          SelectedItem="{Binding SelectedFormat}" />
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Qualität'}" />
                                <Slider Grid.Column="1" Minimum="1" Maximum="100"
                                        Value="{Binding Quality}"
                                        IsEnabled="{Binding QualityApplies}"
                                        ToolTip.Tip="{l:T 'Höher = schöner, aber größere Datei. 75–85 ist für Fotos meist der beste Kompromiss.'}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding Quality, StringFormat='{}{0:F0}'}" />
                            </Grid>

                            <CheckBox IsChecked="{Binding Lossless}" IsVisible="{Binding LosslessAvailable}"
                                      Content="{l:T 'Verlustfrei'}" FontSize="12"
                                      ToolTip.Tip="{l:T 'Jedes Pixel bleibt exakt erhalten. Ideal für Grafiken, Screenshots und Buttons — bei Fotos deutlich größer.'}" />
                            <TextBlock Classes="hint" IsVisible="{Binding !QualityApplies}" Margin="0,0,0,2"
                                       Text="{l:T 'Dieses Format speichert immer verlustfrei.'}" />

                            <!-- Echte Schätzung: eine Probe wird im Zielformat kodiert -->
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="{DynamicResource RadiusControl}"
                                    Padding="10,7" Margin="0,8,0,0"
                                    ToolTip.Tip="{l:T 'Berechnet aus einer Probe im Zielformat mit allen Einstellungen. Ohne „≈“ ist es die exakte Größe.'}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="good" Text="{Binding EstimatedSize}" />
                                        <TextBlock Classes="hint" Text="{l:T 'wird berechnet …'}"
                                                   IsVisible="{Binding IsEstimating}" />
                                    </StackPanel>
                                    <TextBlock Classes="hint" Text="{Binding SavingsText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Zuschnitt -->
                    <HeaderedContentControl x:Name="CropGroup" Header="{l:T 'ZUSCHNITT'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Verhältnis'}" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding AspectPresets}"
                                          SelectedItem="{Binding SelectedAspectPreset}" />
                            </Grid>

                            <!-- Noch keine Auswahl: kurze Anleitung -->
                            <Border IsVisible="{Binding !HasCropSelection}"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="✂" FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Classes="hint"
                                               Text="{l:T 'Mit gedrückter linker Maustaste über das Bild ziehen, um einen Ausschnitt zu wählen.'}" />
                                </Grid>
                            </Border>

                            <!-- Auswahl vorhanden -->
                            <StackPanel IsVisible="{Binding HasCropSelection}">
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto,*">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Position'}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CropX}" Minimum="0" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="," Margin="7,0" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding CropY}" Minimum="0" />
                                </Grid>

                                <Grid Classes="row" ColumnDefinitions="76,*,Auto,*">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Größe'}" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding CropWidth}" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="×" Margin="7,0" />
                                    <NumericUpDown Grid.Column="3" Value="{Binding CropHeight}" />
                                </Grid>

                                <!-- Runde Ecken: Max = halbe längste Seite → Ellipse bzw. Kreis -->
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Ecken'}" />
                                    <Slider Grid.Column="1" Minimum="0"
                                            Maximum="{Binding MaxCornerRadius}"
                                            Value="{Binding CornerRadius}"
                                            ToolTip.Tip="{l:T 'Rundet die Ecken der Auswahl ab. Ganz rechts wird daraus eine Ellipse — bei Verhältnis 1:1 ein Kreis. Alles außerhalb der Rundung wird beim Zuschneiden transparent.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" MinWidth="50"
                                               Text="{Binding CornerRadiusLabel}" />
                                </Grid>

                                <Border IsVisible="{Binding ShowTransparencyWarning}"
                                        Background="#1FE0A100" BorderBrush="#66E0A100"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusControl}"
                                        Padding="10,7" Margin="0,0,0,10">
                                    <TextBlock Classes="hint"
                                               Text="{l:T 'JPEG und BMP kennen keine Transparenz — die runden Ecken würden weiß. Für Buttons PNG oder WebP wählen.'}" />
                                </Border>

                                <Grid ColumnDefinitions="Auto,8,*">
                                    <Button Grid.Column="0" Classes="subtle"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding ClearSelectionCommand}"
                                            Content="{l:T 'Auswahl aufheben'}"
                                            ToolTip.Tip="{l:T 'Rahmen entfernen, das Bild bleibt unverändert (Esc).'}" />
                                    <Button Grid.Column="2" Classes="primary"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding CropToSelectionCommand}"
                                            Content="{l:T 'Auf Auswahl zuschneiden'}"
                                            ToolTip.Tip="{l:T 'Der Ausschnitt wird zum neuen Bild. Bei runden Ecken wird alles außerhalb der Rundung transparent. Rückgängig mit Strg+Z. Auch per Enter oder Doppelklick in den Rahmen.'}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Größe -->
                    <HeaderedContentControl Header="{l:T 'GRÖSSE'}">
                        <StackPanel>
                            <!-- Einheit: Pixel oder Millimeter (Druckgröße bei der eingestellten DPI) -->
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Einheit'}" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding SizeUnits}"
                                          SelectedItem="{Binding SelectedSizeUnit}"
                                          ToolTip.Tip="{l:T 'Pixel: Bildgröße in Pixeln. mm: Druckgröße in Millimetern — die Pixel ergeben sich aus der DPI (unten bei Auflösung).'}" />
                            </Grid>

                            <!-- Breite × Höhe mit Kette: zu = proportional, offen = frei -->
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Maße'}" />
                                <NumericUpDown Grid.Column="1" Value="{Binding FieldWidth}"
                                               FormatString="{Binding SizeFormat}"
                                               Minimum="{Binding SizeMinimum}" Increment="1"
                                               Classes.derived="{Binding KeepAspectRatio}"
                                               Classes.leading="{Binding WidthIsLeading}" />
                                <TextBlock Grid.Column="2" Classes="label" Text="×" Margin="7,0" />
                                <NumericUpDown Grid.Column="3" Value="{Binding FieldHeight}"
                                               FormatString="{Binding SizeFormat}"
                                               Minimum="{Binding SizeMinimum}" Increment="1"
                                               Classes.derived="{Binding KeepAspectRatio}"
                                               Classes.leading="{Binding !WidthIsLeading}" />
                                <ToggleButton Grid.Column="4" Classes="chain" Margin="8,0,0,0"
                                              IsChecked="{Binding KeepAspectRatio}"
                                              ToolTip.Tip="{l:T 'Kette geschlossen: Seitenverhältnis bleibt, die zweite Kante rechnet sich mit. Kette offen: Breite und Höhe frei — das Bild wird gestaucht oder gestreckt.'}">
                                    <Panel Width="24" Height="24">
                                        <!-- Zwei Kettenglieder, um 45° gedreht -->
                                        <Canvas Width="24" Height="24" IsVisible="{Binding KeepAspectRatio}">
                                            <Canvas.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Canvas.RenderTransform>
                                            <Rectangle Canvas.Left="1.5" Canvas.Top="8" Width="12" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource AccentBrush}" />
                                            <Rectangle Canvas.Left="10.5" Canvas.Top="8" Width="12" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource AccentBrush}" />
                                        </Canvas>
                                        <!-- Gebrochen: Glieder auseinander, Bruchstriche dazwischen -->
                                        <Canvas Width="24" Height="24" IsVisible="{Binding !KeepAspectRatio}">
                                            <Canvas.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Canvas.RenderTransform>
                                            <Rectangle Canvas.Left="-1" Canvas.Top="8" Width="10" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource TextMutedBrush}" />
                                            <Rectangle Canvas.Left="15" Canvas.Top="8" Width="10" Height="8"
                                                       RadiusX="4" RadiusY="4" StrokeThickness="2.2"
                                                       Stroke="{DynamicResource TextMutedBrush}" />
                                            <Line StartPoint="12,2" EndPoint="12,5.5" StrokeThickness="2"
                                                  StrokeLineCap="Round" Stroke="{DynamicResource TextMutedBrush}" />
                                            <Line StartPoint="12,18.5" EndPoint="12,22" StrokeThickness="2"
                                                  StrokeLineCap="Round" Stroke="{DynamicResource TextMutedBrush}" />
                                        </Canvas>
                                    </Panel>
                                </ToggleButton>
                            </Grid>

                            <!-- Im mm-Modus: welche Pixel daraus werden -->
                            <TextBlock Classes="hint" Margin="76,-4,0,8"
                                       IsVisible="{Binding HasPixelEquivalent}"
                                       Text="{Binding PixelEquivalent}" />

                            <!-- Hinweis, wenn das Ziel größer ist als das Original -->
                            <TextBlock Classes="hint" Margin="76,-4,0,10"
                                       IsVisible="{Binding HasUpscaleHint}"
                                       Text="{Binding UpscaleHint}" />

                            <!-- Filter: jeder Eintrag erklärt sich im Tooltip -->
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Filter'}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Filters}"
                                          SelectedItem="{Binding SelectedFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:FilterOption">
                                            <Border Background="Transparent">
                                                <ToolTip.Tip>
                                                    <StackPanel MaxWidth="290" Spacing="6">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{l:TItem Path=Description}" TextWrapping="Wrap" />
                                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                                            <Run Text="{l:T 'Gut für:'}" />
                                                            <Run Text="{l:TItem Path=BestFor}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                                <TextBlock Text="{Binding Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBlock Classes="hint" Margin="76,-4,0,10"
                                       Text="{l:TItem Path=SelectedFilter.BestFor}" />

                            <StackPanel Spacing="6">
                                <CheckBox IsChecked="{Binding DoNotEnlarge}"
                                          Content="{l:T 'Nicht vergrößern'}" FontSize="12"
                                          ToolTip.Tip="{l:T 'Kleine Bilder werden nie größer gerechnet — Vergrößern erfindet keine Details, es macht nur unscharf.'}" />
                                <CheckBox IsChecked="{Binding GammaCorrect}"
                                          Content="{l:T 'Gamma-korrekt skalieren'}" FontSize="12"
                                          ToolTip.Tip="{l:T 'Rechnet so, wie das Auge Helligkeit wahrnimmt: Feine helle Linien und Kanten werden beim Verkleinern nicht dunkler. Gilt für jedes Umrechnen der Pixel — auch, wenn sich die Pixelzahl durch eine neue DPI ändert. Kostet etwas Zeit, sieht fast immer besser aus.'}" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Auflösung und DPI -->
                    <HeaderedContentControl Header="{l:T 'AUFLÖSUNG &amp; DPI'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="DPI" />
                                <NumericUpDown Grid.Column="1" Value="{Binding Dpi}"
                                               Minimum="1" Maximum="2400"
                                               ToolTip.Tip="{l:T 'Bis 2400 eintippbar, z. B. für Scans von Strichzeichnungen.'}" />
                                <TextBlock Grid.Column="2" Classes="label" Text="ppi" Margin="7,0,0,0" />
                            </Grid>

                            <!-- Regler 72–1200, mit Marken bei den üblichen Werten; Feld und Regler folgen einander -->
                            <Slider Minimum="72" Maximum="1200" Margin="76,-6,0,0"
                                    SmallChange="1" LargeChange="50"
                                    Ticks="72,96,150,300,600,1200" TickPlacement="BottomRight"
                                    Value="{Binding Dpi}"
                                    ToolTip.Tip="{l:T '72–96: Bildschirm · 150: einfacher Druck · 300: Fotodruck · 600: Kunstdruck · 1200: Strichzeichnungen'}" />
                            <TextBlock Classes="hint" Margin="76,0,0,10" Text="{Binding DpiPurpose}" />

                            <StackPanel Spacing="6" Margin="0,0,0,8">
                                <RadioButton GroupName="dpi" FontSize="12"
                                             IsChecked="{Binding !DpiMetadataOnly}"
                                             Content="{l:T 'Pixel neu berechnen'}"
                                             ToolTip.Tip="{l:T 'Die Druckgröße bleibt gleich, die Pixelzahl folgt der DPI: mehr DPI = mehr Pixel. Skaliert mit dem gewählten Filter.'}" />
                                <RadioButton GroupName="dpi" FontSize="12"
                                             IsChecked="{Binding DpiMetadataOnly}"
                                             Content="{l:T 'Nur Metadaten ändern'}"
                                             ToolTip.Tip="{l:T 'Die Pixel bleiben wie sie sind — verlustfrei. Es ändert sich nur, wie groß das Bild beim Drucken herauskommt.'}" />
                            </StackPanel>

                            <TextBlock Classes="hint" Text="{Binding PrintSize}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Schärfen (wirkt als letzter Schritt, auch auf das KI-Ergebnis) -->
                    <HeaderedContentControl Header="{l:T 'SCHÄRFEN &amp; RAUSCHEN'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Schärfen'}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="3"
                                        Value="{Binding SharpenAmount}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding SharpenLabel}" />
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Radius'}" />
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="5"
                                        Value="{Binding SharpenRadius}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding SharpenRadius, StringFormat='{}{0:F1}'}" />
                            </Grid>

                            <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Rauschen'}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="3"
                                        Value="{Binding NoiseReduction}" />
                                <TextBlock Grid.Column="2" Classes="value"
                                           Text="{Binding NoiseLabel}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    </StackPanel>

                    <!-- ############################## Rubrik KI (eigenes Modul, Ordner Ai/) -->
                    <ai:AiPanel DataContext="{Binding Ai}" IsVisible="{Binding #TabAi.IsChecked}" />

                    <!-- ############################## Rubrik Tools — je Funktion ein Regler -->
                    <StackPanel Spacing="10" IsVisible="{Binding #TabTools.IsChecked}">
                        <HeaderedContentControl Header="{l:T 'LICHT'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Helligkeit'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Brightness}"
                                            ToolTip.Tip="{l:T 'Hellt die Mitten auf oder dunkelt sie ab. Schwarz und Weiß bleiben, nichts frisst aus.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding BrightnessLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Kontrast'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}"
                                            ToolTip.Tip="{l:T 'Rechts: Helles heller, Dunkles dunkler — knackiger. Links: weicher, flacher.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding ContrastLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Tiefen'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Shadows}"
                                            ToolTip.Tip="{l:T 'Rechts: dunkle Bereiche aufhellen, z. B. Gesichter im Gegenlicht. Wirkt nur dort, wo die Umgebung dunkel ist — helle Bereiche bleiben.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding ShadowsLabel}" />
                                </Grid>
                                <Grid ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Lichter'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Highlights}"
                                            ToolTip.Tip="{l:T 'Links: helle Bereiche abdunkeln und Zeichnung zurückholen, z. B. im Himmel. Wirkt nur dort, wo die Umgebung hell ist.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding HighlightsLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Dunst mit Feineinstellung (Beta): Die Feinregler wirken nur, wenn Dunst
                             entfernt wird; ihre Vorgaben sind die bis 0.4.40 fest eingebauten Werte.
                             Der ganze Block rechnet bei jeder Reglerbewegung vom Original neu. -->
                        <HeaderedContentControl Header="{l:T 'DUNST · BETA'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dunst'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="300" Value="{Binding Dehaze}"
                                            ToolTip.Tip="{l:T 'Rechts: Dunst und Nebel entfernen — ferne Berge, Stadt im Smog, Aufnahmen durchs Fenster bekommen wieder Kontrast und Farbe. Bis 100 so viel, wie physikalisch geschätzt wird, darüber kräftiger (bis 300). Links: Dunst hinzufügen, für eine weiche Stimmung.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeLabel}" />
                                </Grid>
                                <StackPanel>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Durchläufe'}" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DehazePasses}"
                                                ToolTip.Tip="{l:T 'Wie oft der Dunst nacheinander entfernt wird — wie das Auge: Ergebnis ansehen, wieder schätzen. Je Durchlauf wirken auch Kontrast, Dynamik und Schärfe aus dieser Gruppe mit ihrem Reglerwert; der nächste Durchlauf schätzt den kontrastreicheren Stand neu. Wo der Dunst weg ist, passiert nichts mehr; die Ferne wird klarer. 3 bis 4 sind meist gut, der Himmel bleibt ab dem zweiten unverändert.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazePassesLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Klarheit'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeClarity}"
                                                ToolTip.Tip="{l:T 'Lokaler Kontrast mit großem Radius, kantentreu — Strukturen in der Ferne treten hervor. Nicht im Himmel.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeClarityLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Kontrast'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeContrast}"
                                                ToolTip.Tip="{l:T 'Sanfte S-Kurve auf der Helligkeit nach dem Entfernen.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeContrastLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dynamik'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeVibrance}"
                                                ToolTip.Tip="{l:T 'Blasse Farben (Ferne) bekommen mehr Buntheit, kräftige kaum. Nicht im Himmel.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeVibranceLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Schärfe fein'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeSharpen}"
                                                ToolTip.Tip="{l:T 'Feine Schärfe (3 × 3 Pixel) auf der Landschaft — Details, die der Dunst verschluckt hat.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeSharpenLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Kanten'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeEdge}"
                                                ToolTip.Tip="{l:T 'Kantenschärfe mit größerem Radius (2 Pixel), nach allen Durchläufen. Vorgabe aus — erst, wenn die feine Schärfe nicht reicht.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeEdgeLabel}" />
                                    </Grid>
                                    <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Helligkeit'}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DehazeBrightness}"
                                                ToolTip.Tip="{l:T 'Wie weit die Helligkeit großräumig wieder ans Original angeglichen wird. 100: so hell wie vorher; 0: so dunkel, wie die Szene ohne Dunst wäre.'}" />
                                        <TextBlock Grid.Column="2" Classes="value" Text="{Binding DehazeBrightnessLabel}" />
                                    </Grid>
                                    <Button Classes="tool" HorizontalAlignment="Right" Content="{l:T 'Vorgaben'}"
                                            Command="{Binding ResetDehazeDetailsCommand}"
                                            ToolTip.Tip="{l:T 'Feineinstellung zurück auf die Vorgaben (ein Durchlauf, Werte wie vor der Beta). Der Dunst-Regler bleibt.'}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="{l:T 'FARBE'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dynamik'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Vibrance}"
                                            ToolTip.Tip="{l:T 'Rechts: blasse Farben kräftiger, schon kräftige kaum — Hauttöne bleiben natürlich. Lebendiger als Sättigung, ohne bunt zu wirken.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding VibranceLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Sättigung'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Saturation}"
                                            ToolTip.Tip="{l:T 'Rechts: alle Farben gleich stark kräftiger. Ganz links: Schwarzweiß.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding SaturationLabel}" />
                                </Grid>
                                <Grid ColumnDefinitions="76,*">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Färben'}" />
                                    <ComboBox Classes="tr" Grid.Column="1" ItemsSource="{Binding Tints}" SelectedItem="{Binding SelectedTint}"
                                              ToolTip.Tip="{l:T 'Das ganze Bild in einem Farbton: Schwarzweiß oder eine Farbe nach Wahl — z. B. Sepia wie ein alter Fotoabzug.'}" />
                                </Grid>
                                <!-- Farbton: die Leiste dahinter zeigt den Farbkreis -->
                                <Grid ColumnDefinitions="76,*,Auto" Margin="0,8,0,0" IsVisible="{Binding IsTintColor}">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Farbton'}" />
                                    <Panel Grid.Column="1">
                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                    <GradientStop Offset="0" Color="#B5583F" />
                                                    <GradientStop Offset="0.0833" Color="#B57F3F" />
                                                    <GradientStop Offset="0.1667" Color="#B5A63F" />
                                                    <GradientStop Offset="0.3333" Color="#58B53F" />
                                                    <GradientStop Offset="0.5" Color="#3FB5A6" />
                                                    <GradientStop Offset="0.6667" Color="#3F58B5" />
                                                    <GradientStop Offset="0.8333" Color="#A63FB5" />
                                                    <GradientStop Offset="1" Color="#B5583F" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- Spur durchsichtig, darunter liegt der Farbkreis. Die Ressourcen hier am
                                             Regler, nicht in einem Stil: Stil-Ressourcen gelten in Avalonia für alle
                                             Regler der Anwendung (in 0.4.28 waren dadurch alle Spuren unsichtbar). -->
                                        <Slider Minimum="0" Maximum="360" Value="{Binding TintHue}"
                                                ToolTip.Tip="{l:T 'Farbe der Tönung. Um 30°: Sepia, um 210°: kühles Blau.'}">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            </Slider.Resources>
                                        </Slider>
                                    </Panel>
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding TintHueLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Nachbau von Referenzwerkzeug CS5 „Bild > Korrekturen > Gleiche Farbe“ ohne Quellbild -->
                        <HeaderedContentControl Header="{l:T 'GLEICHE FARBE'}">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Luminanz'}" />
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding MatchLuminance}"
                                            ToolTip.Tip="{l:T 'Wie „Gleiche Farbe“ in Referenzwerkzeug CS5: rechnet die Helligkeit hoch statt sie nur anzuheben — das Bild wird leuchtender, die Kontraste bleiben. Weiß läuft weich aus, nichts frisst aus.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding MatchLuminanceLabel}" />
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Ausgleichen'}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Neutralize}"
                                            ToolTip.Tip="{l:T 'Entfernt einen Farbstich (z. B. gelbes Kunstlicht, blauer Schatten): Graues und Weißes wird wieder neutral. Der Regler bestimmt, wie viel davon. Kräftige Farben zählen bei der Erkennung nicht mit.'}" />
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding NeutralizeLabel}" />
                                </Grid>
                                <!-- Farbe: Verlauf kühl → neutral → warm hinter durchsichtiger Spur -->
                                <Grid ColumnDefinitions="76,*,Auto">
                                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Farbe'}" />
                                    <Panel Grid.Column="1">
                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                    <GradientStop Offset="0" Color="#4C7FD0" />
                                                    <GradientStop Offset="0.5" Color="#C8C8C8" />
                                                    <GradientStop Offset="1" Color="#E0B040" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding Warmth}"
                                                ToolTip.Tip="{l:T 'Links kühler (bläulich), rechts wärmer (gelblich), Mitte neutral — z. B. wenn Ausgleichen ein Kunstlicht-Foto zu kühl gemacht hat.'}">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent" />
                                            </Slider.Resources>
                                        </Slider>
                                    </Panel>
                                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding WarmthLabel}" />
                                </Grid>
                            </StackPanel>
                        </HeaderedContentControl>

                        <Button Classes="subtle" HorizontalAlignment="Left" Content="{l:T 'Zurücksetzen'}"
                                Command="{Binding ResetToolsCommand}"
                                ToolTip.Tip="{l:T 'Alle Regler dieser Kachel auf 0, Färben aus. Rückgängig mit Strg+Z.'}" />
                    </StackPanel>

                    <!-- ############################## Rubrik Ausgabe -->
                    <StackPanel Spacing="10" IsVisible="{Binding #TabOutput.IsChecked}">

                    <!-- ============================== Metadaten und Farbe -->
                    <HeaderedContentControl Header="{l:T 'METADATEN &amp; FARBE'}">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="EXIF" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding MetadataModes}"
                                          ToolTip.Tip="{l:T 'EXIF/IPTC/XMP: Kamera, Datum, Ort, Copyright. „Nur GPS entfernen“ löscht die Ortsangaben — sinnvoll vor dem Teilen im Netz.'}"
                                          SelectedItem="{Binding SelectedMetadataMode}" />
                            </Grid>

                            <Grid ColumnDefinitions="76,*">
                                <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'ICC-Profil'}" />
                                <ComboBox Classes="tr" Grid.Column="1"
                                          ItemsSource="{Binding ColorModes}"
                                          ToolTip.Tip="{l:T 'Profil behalten: Farbraum wie im Original (z. B. Adobe RGB für den Druck). Nach sRGB: überall richtige Farben — Standard fürs Web. Profil verwerfen: sRGB ohne eingebettetes Profil, etwas kleinere Datei.'}"
                                          SelectedItem="{Binding SelectedColorMode}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- ============================== Ausgabe -->
                    <HeaderedContentControl Header="{l:T 'AUSGABE'}">
                        <Grid ColumnDefinitions="76,*">
                            <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Dateiname'}" />
                            <TextBox Grid.Column="1" Text="{Binding NamePattern}"
                                     FontSize="12"
                                     CornerRadius="{DynamicResource RadiusControl}">
                                <!-- Als Element: die Platzhalter {name} … würden in {l:T …} als Erweiterung gelesen -->
                                <ToolTip.Tip>
                                    <l:T Text="Platzhalter: {name} Dateiname ohne Endung · {breite} {höhe} Pixelmaße · {n} laufende Nummer · {datum} heutiges Datum. Die Endung kommt automatisch dazu." />
                                </ToolTip.Tip>
                            </TextBox>
                        </Grid>
                    </HeaderedContentControl>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Trennlinie -->
            <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource BorderBrush2}" />

            <!-- Bildfläche rechts -->
            <DockPanel Grid.Column="3" LastChildFill="True">

                <!-- Werkzeugleiste unter dem Bild -->
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <Button Grid.Column="0" Classes="tool" MinWidth="56"
                                IsVisible="{Binding HasImage}"
                                Click="OnFitToViewClick"
                                Content="{Binding #Crop.DisplayPercent, StringFormat='{}{0} %'}">
                            <ToolTip.Tip>
                                <StackPanel Spacing="4" MaxWidth="280">
                                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Zoom'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Strg + Mausrad über dem Bild zoomt um den Mauszeiger.'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Im Zoom verschieben: mittlere Maustaste ziehen, Leertaste + Ziehen oder Mausrad (mit Umschalt waagerecht).'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Klick hier oder Strg+0: einpassen · Strg+1: 100 %'}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:T 'Die Prozente beziehen sich auf das Ergebnis in der eingestellten Größe.'}" />
                                </StackPanel>
                            </ToolTip.Tip>
                        </Button>

                        <Rectangle Grid.Column="1" Width="1" Margin="10,4"
                                   Fill="{DynamicResource BorderBrush2}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Classes="tool" Content="{l:T '↶  Rückgängig'}"
                                    Command="{Binding UndoCommand}"
                                    ToolTip.Tip="{l:T 'Letzten Schritt zurücknehmen (Strg+Z). Nach einem Zuschnitt kommt der Rahmen wieder, zum Nachjustieren.'}" />
                            <Button Classes="tool" Content="{l:T '↷  Wiederholen'}"
                                    Command="{Binding RedoCommand}"
                                    ToolTip.Tip="{l:T 'Zurückgenommenen Schritt erneut ausführen (Strg+Y).'}" />

                            <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource BorderBrush2}" />

                            <Button Classes="icon" Content="⇄" Command="{Binding FlipHorizontalCommand}"
                                    ToolTip.Tip="{l:T 'Waagerecht spiegeln (links ↔ rechts). Rückgängig mit Strg+Z.'}" />
                        </StackPanel>

                        <ToggleButton Grid.Column="4" Classes="chain" Width="NaN" Padding="12,5"
                                      IsChecked="{Binding ShowOriginal}"
                                      IsEnabled="{Binding CanCompare}"
                                      Content="{l:T '◧  Vorher / Nachher'}" FontSize="12"
                                      ToolTip.Tip="{l:T 'Vergleich mit Trennlinie: links Vorher — das Bild vor den KI-Schritten, ohne Größe, Entrauschen, Tools und Schärfe —, rechts das Ergebnis, so wie es exportiert wird. Die Linie mit der Maus über das Bild ziehen. Zoom und Ausschnitt bleiben gleich.'}" />
                    </Grid>
                </Border>

                <!-- Leinwand: Auswahlrahmen erscheint erst beim Aufziehen -->
                <Border Background="{DynamicResource CanvasBrush}">
                    <Grid>
                        <c:CropView x:Name="Crop"
                                    IsVisible="{Binding HasImage}"
                                    Source="{Binding DisplayBitmap}"
                                    CompareSource="{Binding CompareBitmap}"
                                    BeforeLabel="{l:T 'Vorher'}"
                                    AfterLabel="{l:T 'Nachher'}"
                                    DocumentSize="{Binding DocumentSize}"
                                    OutputSize="{Binding ViewOutputSize}"
                                    ViewResetToken="{Binding ViewResetToken}"
                                    Selection="{Binding CropSelection}"
                                    AspectRatio="{Binding AspectRatio}"
                                    SelectionRadius="{Binding CornerRadius}"
                                    CropCommand="{Binding CropToSelectionCommand}"
                                    GestureCompletedCommand="{Binding CommitSettingsStepCommand}" />

                        <!-- Leerer Zustand: große Drop-Zone -->
                        <Grid IsVisible="{Binding !HasImage}"
                              Margin="40" MaxWidth="560" MaxHeight="360">
                            <Rectangle RadiusX="16" RadiusY="16"
                                       Fill="{DynamicResource SurfaceBrush}"
                                       Stroke="{DynamicResource BorderStrongBrush}"
                                       StrokeThickness="2" StrokeDashArray="4,3" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="🖼" FontSize="44" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{l:T 'Bilder hierher ziehen'}" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="{l:T 'Einzelne Bilder, mehrere auf einmal oder einen ganzen Ordner.'}" />
                                <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="{Binding SupportedFormatsSummary}" />
                                <Button Classes="primary" HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Content="{l:T 'Bilder auswählen…'}" Click="OnOpenFilesClick" />
                            </StackPanel>
                        </Grid>

                        <!-- Drehen: gebogene Pfeile oben in den Ecken der Vorschau.
                             Pfadform nach den Lucide-Icons rotate-ccw/rotate-cw (ISC-Lizenz). -->
                        <Button Classes="corner" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding HasImage}"
                                Command="{Binding RotateLeftCommand}"
                                ToolTip.Tip="{l:T '90° nach links drehen (gegen den Uhrzeigersinn). Rückgängig mit Strg+Z.'}">
                            <Path Data="M 3,12 A 9,9 0 1 0 12,3 A 9.75,9.75 0 0 0 5.26,5.74 L 3,8 M 3,3 L 3,8 L 8,8" />
                        </Button>
                        <Button Classes="corner" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsVisible="{Binding HasImage}"
                                Command="{Binding RotateRightCommand}"
                                ToolTip.Tip="{l:T '90° nach rechts drehen (im Uhrzeigersinn). Rückgängig mit Strg+Z.'}">
                            <Path Data="M 21,12 A 9,9 0 1 1 12,3 A 9.75,9.75 0 0 1 18.74,5.74 L 21,8 M 21,3 L 21,8 L 16,8" />
                        </Button>

                        <!-- Hinweis über dem Bild -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Padding="12,5"
                                IsVisible="{Binding HasImage}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="999" Opacity="0.92"
                                IsHitTestVisible="False">
                            <TextBlock Classes="hint"
                                       Text="{l:T 'Ausschnitt aufziehen  ·  Enter schneidet zu  ·  Esc hebt auf  ·  Strg + Mausrad zoomt'}" />
                        </Border>

                        <!-- Ladeanzeige -->
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                     VerticalAlignment="Top" Height="3" MinHeight="3"
                                     CornerRadius="0" />

                        <!-- Erscheint nur, wenn eine Vorschau-Berechnung spürbar dauert -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="12" Padding="10,4" CornerRadius="999"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                IsVisible="{Binding ShowRendering}" IsHitTestVisible="False">
                            <TextBlock Classes="hint" Text="{l:T 'Vorschau wird berechnet …'}" />
                        </Border>

                        <!-- Lange Arbeiten (z. B. KI): Fortschritt direkt über dem Bild -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="12" Padding="12,5" CornerRadius="999"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                IsVisible="{Binding ActivityText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                IsHitTestVisible="False">
                            <TextBlock Classes="hint" Text="{Binding ActivityText}" />
                        </Border>

                        <!-- Wird beim Hineinziehen von Dateien eingeblendet -->
                        <Grid x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
                              Margin="12" Opacity="0.95">
                            <Rectangle RadiusX="14" RadiusY="14"
                                       Fill="{DynamicResource AccentSoftBrush}"
                                       Stroke="{DynamicResource AccentBrush}"
                                       StrokeThickness="2" StrokeDashArray="4,3" />
                            <TextBlock Text="{l:T 'Loslassen zum Öffnen'}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
