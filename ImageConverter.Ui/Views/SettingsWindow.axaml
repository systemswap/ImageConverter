<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageConverter.ViewModels"
        xmlns:ai="using:ImageConverter.Ai"
        x:Class="ImageConverter.Views.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Einstellungen"
        Icon="/Assets/app.ico"
        Width="720" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="16,10">
            <Button HorizontalAlignment="Right" Classes="subtle" Content="Schließen" Click="OnCloseClick"
                    ToolTip.Tip="Laufende Downloads gehen im Hintergrund weiter." />
        </Border>

        <TabControl Margin="12,8,12,0" Padding="4,12,4,12">
            <TabItem Header="KI-Modelle" FontSize="14">
                <ai:AiModelsView DataContext="{Binding Ai}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
