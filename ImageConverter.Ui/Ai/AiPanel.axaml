<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImageConverter.Localization"
             xmlns:ai="using:ImageConverter.Ai"
             xmlns:core="using:ImageConverter.Core.Ai"
             x:Class="ImageConverter.Ai.AiPanel"
             x:DataType="ai:AiViewModel">

    <!-- KI-Verbesserung: eigene Gruppe, wird mit einer Zeile in MainView eingebunden -->
    <HeaderedContentControl Header="{l:T 'KI-VERBESSERUNG'}">
        <StackPanel>

            <!-- Noch keine Modelle -->
            <StackPanel IsVisible="{Binding !HasModels}" Spacing="6">
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{l:T 'Noch keine KI-Modelle vorhanden. Sie laufen komplett auf deinem Rechner und werden einmalig heruntergeladen.'}" />
                <Button HorizontalAlignment="Left" Content="{l:T 'Modelle laden …'}" Command="{Binding OpenModelsCommand}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasModels}">
                <Grid Classes="row" ColumnDefinitions="76,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Modell'}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Available}" SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding !IsRunning}"
                              ToolTip.Tip="{Binding ModelHint}">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="core:AiModel">
                                <TextBlock Text="{l:TItem Path=Name}" />
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:AiModel">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{l:TItem Path=Name}" />
                                    <TextBlock Classes="hint" FontSize="11" Text="{l:TItem Path=Purpose}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Classes="row" ColumnDefinitions="76,*,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Stärke'}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Strength}"
                            ToolTip.Tip="{l:T 'Mischung mit dem Bild davor: 100 % = nur das Ergebnis des Modells, darunter wirkt es schwächer und natürlicher. Wirkt live, ohne neu zu rechnen.'}" />
                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding StrengthLabel}" />
                </Grid>

                <Grid Classes="row" ColumnDefinitions="76,*,Auto" IsVisible="{Binding IsFaceModel}">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Hautstruktur'}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Texture}"
                            ToolTip.Tip="{l:T 'Holt Poren und feine Hautstruktur aus dem Bild davor zurück, damit Gesichter nicht glattgebügelt wirken. Augen, Mund und Form bleiben vom Modell. Wirkt live.'}" />
                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding TextureLabel}" />
                </Grid>

                <Grid Classes="row" ColumnDefinitions="76,*,Auto" IsVisible="{Binding HasFidelity}">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Natürlichkeit'}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Fidelity}"
                            ToolTip.Tip="{l:T 'Wie nah CodeFormer am Original bleibt: niedrig = stärkere Verbesserung, die Person kann sich aber verändern; hoch = näher am Original. Geht ins Modell — nach dem Loslassen wird neu gerechnet.'}" />
                    <TextBlock Grid.Column="2" Classes="value" Text="{Binding FidelityLabel}" />
                </Grid>

                <Grid Classes="row" ColumnDefinitions="76,*" IsVisible="{Binding IsEnhanceModel}">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Größe'}" />
                    <ComboBox Classes="tr" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SelectedSize}"
                              IsEnabled="{Binding !IsRunning}"
                              ToolTip.Tip="{l:T '„Größe behalten“: das Modell rechnet in vierfacher Größe und mittelt zurück — sauberer als das Original, gleich viele Pixel. Vergrößern ergänzt Details, die vorher nicht da waren.'}" />
                </Grid>

                <Grid Classes="row" ColumnDefinitions="76,*">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:T 'Reihenfolge'}" />
                    <ComboBox Classes="tr" Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding OrderOptions}" SelectedItem="{Binding SelectedOrder}"
                              IsEnabled="{Binding !IsRunning}"
                              ToolTip.Tip="{l:T 'Einstellungen = Dunst, Licht, Farbe, Entrauschen und Schärfe. Sie wirken nie doppelt: entweder danach auf das KI-Ergebnis oder vorher ins Bild gerechnet.'}" />
                </Grid>
                <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding OrderHint}" />

                <!-- Starten oder Fortschritt -->
                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,4,0,0" Content="{l:T 'KI berechnen'}"
                        IsVisible="{Binding !IsRunning}" Command="{Binding ApplyCommand}"
                        ToolTip.Tip="{l:T 'Rechnet das Modell und zeigt das Ergebnis. Danach wirken die Regler live; ins Bild kommt es erst mit „Übernehmen“. Gerechnet wird immer auf dem Stand vor der letzten KI — nichts häuft sich an.'}" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding IsRunning}">
                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Classes="subtle" Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" />
                </Grid>

                <!-- Offenes Ergebnis: übernehmen oder verwerfen -->
                <Grid ColumnDefinitions="*,6,*" Margin="0,4,0,0" IsVisible="{Binding HasPending}">
                    <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{l:T 'Übernehmen'}" Command="{Binding CommitCommand}"
                            ToolTip.Tip="{l:T 'Schreibt das Ergebnis mit den aktuellen Reglern ins Bild. Rückgängig mit Strg+Z.'}" />
                    <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{l:T 'Verwerfen'}" Command="{Binding DiscardCommand}"
                            ToolTip.Tip="{l:T 'Ergebnis verwerfen — das Bild bleibt, wie es war.'}" />
                </Grid>

                <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding Status}" />
                <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{l:T 'Läuft lokal auf deinem Rechner. Kann je nach Bild einige Minuten dauern.'}" />
            </StackPanel>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
