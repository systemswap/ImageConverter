<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImageConverter.Localization"
             xmlns:ai="using:ImageConverter.Ai"
             x:Class="ImageConverter.Ai.PerformanceView"
             x:DataType="ai:AiViewModel">

    <!-- Einstellungen › Leistung: worauf gerechnet wird, und der Test Grafikkarte gegen CPU -->
    <StackPanel Spacing="10">
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="{l:T 'Rechenintensive Schritte laufen auf der Grafikkarte oder auf der CPU – je nachdem, was auf diesem Rechner schneller ist. Der Test findet das heraus.'}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding FilterGpuStatus}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding GpuStatus}" />

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Classes="primary" Content="{l:T 'Geschwindigkeit testen'}" Command="{Binding TestSpeedCommand}"
                    ToolTip.Tip="{l:T 'Rechnet Entrauschen, Dunst und ein kleines KI-Modell je einmal auf der Grafikkarte und auf der CPU und nutzt danach, was auf diesem Rechner schneller ist. Dann misst er die vorhandenen Upscaler, damit die Zeitschätzung stimmt (PiSA-SR kann einige Minuten dauern).'}" />
            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsSpeedTesting}" />
        </StackPanel>
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding SpeedTestProgress}"
                   IsVisible="{Binding SpeedTestProgress, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Classes="label" FontWeight="SemiBold" Margin="0,8,0,0" Text="{l:T 'Letztes Ergebnis'}" />
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding SpeedTestText}" />

        <!-- Rechner bedienbar halten: niedrige Priorität (Vorgabe) und Obergrenze -->
        <TextBlock Classes="label" FontWeight="SemiBold" Margin="0,16,0,0" Text="{l:T 'Rechner bedienbar halten'}" />
        <CheckBox IsChecked="{Binding LowPriority}" Content="{l:T 'Mit niedriger Priorität rechnen (empfohlen)'}"
                  ToolTip.Tip="{l:T 'Andere Programme haben Vorrang, der Rechner bleibt bedienbar. Ist er sonst frei, wird trotzdem mit voller Kraft gerechnet.'}" />
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding PriorityHint}"
                   IsVisible="{Binding PriorityHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T 'CPU höchstens'}" />
            <Slider Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    Value="{Binding CpuPercent}"
                    ToolTip.Tip="{l:T 'Begrenzt, wie viele Kerne KI, Bildfilter und Umwandeln gleichzeitig nutzen. Mit der Hälfte dauert es meist nur rund ein Viertel länger, der Lüfter bleibt ruhiger.'}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="150" Text="{Binding CpuPercentLabel}" />
        </Grid>
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding CpuRestartHint}"
                   IsVisible="{Binding CpuRestartHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="{l:T 'Nach einer Änderung der Obergrenze am besten neu testen – die Zeiten gelten je Einstellung.'}" />
    </StackPanel>
</UserControl>
