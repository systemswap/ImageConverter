<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ImageConverter.Localization">

    <!-- ===================================================================
         GroupBox
         Avalonia hat keinen GroupBox. HeaderedContentControl bringt die
         Struktur mit (Header + Content) und bekommt hier ein eigenes
         ControlTheme: Karte mit Rahmen, Titelzeile, Trennlinie.
         =================================================================== -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type HeaderedContentControl}" TargetType="HeaderedContentControl">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusCard}">
                        <DockPanel LastChildFill="True">
                            <!-- Titelzeile -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="7,7,0,0"
                                    Padding="12,6">
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Content="{TemplateBinding Header}"
                                                  TextElement.FontSize="11"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <!-- Inhalt -->
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{DynamicResource CardPadding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- ===================================================================
         Typografie
         =================================================================== -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.good">
        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================================================================
         Leisten oben und unten
         =================================================================== -->
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ===================================================================
         Buttons
         =================================================================== -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <!-- Umschalter in derselben Form wie Button.subtle; eingeschaltet in der Akzentfarbe (z. B. „Linien zeichnen“) -->
    <Style Selector="ToggleButton.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="ToggleButton.subtle:checked /template/ ContentPresenter,
                     ToggleButton.subtle:checked:pointerover /template/ ContentPresenter,
                     ToggleButton.subtle:checked:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Kleine Knöpfe für schwebende Felder in der Vorschau („Gewölbtes Blatt“); nach .subtle/.primary, damit sie gewinnen -->
    <Style Selector="Button.compact, ToggleButton.compact">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary.compact">
        <Setter Property="Padding" Value="14,5" />
    </Style>

    <!-- Quadratische Icon-Buttons fuer die Zoom-/Dreh-Leiste -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Runde, schwebende Buttons in den Ecken der Vorschau (Drehen) -->
    <Style Selector="Button.corner">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.92" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Effect">
            <DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="1" Opacity="0.18" />
        </Setter>
    </Style>
    <Style Selector="Button.corner:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.corner:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.corner Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.corner:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Runder Umschaltknopf in der Vorschau (Auswahlwerkzeug): aussehen wie die Drehknöpfe,
         eingeschaltet blau gefüllt mit weißem Symbol -->
    <Style Selector="ToggleButton.corner">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.92" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Effect">
            <DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="1" Opacity="0.18" />
        </Setter>
    </Style>
    <Style Selector="ToggleButton.corner:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.corner:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.corner:checked /template/ ContentPresenter,
                     ToggleButton.corner:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.corner Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="ToggleButton.corner:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.corner:checked Path">
        <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- Auge in der Liste „Bearbeitungen“: offen = Bearbeitung wirkt, durchgestrichen = ausgeblendet -->
    <Style Selector="ToggleButton.eye">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter,
                     ToggleButton.eye:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.eye:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ToggleButton.eye Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="ToggleButton.eye:checked Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.eye:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Flache Textbuttons in der Werkzeugleiste (Rückgängig/Wiederholen) -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ===================================================================
         Eingabefelder
         =================================================================== -->
    <Style Selector="NumericUpDown">
        <Setter Property="FormatString" Value="0" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="Minimum" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <!-- Das abgeleitete Maß wird gedimmt: so sieht man, welcher Wert
         gerechnet ist und welcher getippt wurde. -->
    <Style Selector="NumericUpDown.derived:not(.leading)">
        <Setter Property="Opacity" Value="0.62" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,-4" />
    </Style>

    <!-- Kettensymbol: an = Akzentfarbe -->
    <!-- Knopf „Standardformat“ über der Kette: gleich groß, Symbol wie die offene Kette, beim Zeigen blau -->
    <Style Selector="Button.paper">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.paper Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.paper:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.chain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.chain:checked /template/ ContentPresenter,
                     ToggleButton.chain:checked:pointerover /template/ ContentPresenter,
                     ToggleButton.chain:checked:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===================================================================
         Kachelleiste links: Rubriken (Standard, KI, Tools, Ausgabe)
         =================================================================== -->
    <Style Selector="Border.rail">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="6,10" />
    </Style>

    <Style Selector="RadioButton.tile">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MaxWidth" Value="196" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg" Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource RadiusControl}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                      Padding="{TemplateBinding Padding}"
                                      Margin="0,0,10,0" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tile:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="RadioButton.tile:checked">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.tile Path, ToggleButton.railToggle Path">
        <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="TextBlock.tileName">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground}" />
    </Style>
    <Style Selector="TextBlock.tileHint">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="140" />
    </Style>

    <!-- Auf-/Zuklappen der Leiste: Pfeile drehen sich beim Aufklappen um -->
    <Style Selector="ToggleButton.railToggle">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.railToggle:checked /template/ ContentPresenter,
                     ToggleButton.railToggle:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.railToggle:checked Viewbox">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <!-- Listen, deren Werte deutsche Texte sind (Kennungen im ViewModel): angezeigt wird
         die Übersetzung, der Wert bleibt. -->
    <Style Selector="ComboBox.tr">
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="x:String">
                <TextBlock Text="{l:TItem}" />
            </DataTemplate>
        </Setter>
    </Style>

    <!-- Reihe "Label ... Steuerelement" in den GroupBoxen -->
    <Style Selector="Grid.row">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ===================================================================
         Einstellungsspalte links: feiner und ruhiger
         Kleinere Schrift, niedrigere Felder, engere Zeilen. Gilt nur innerhalb
         von .settings, damit Kopf- und Fußleiste ihre Größe behalten.
         =================================================================== -->
    <Style Selector=".settings Grid.row">
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style Selector=".settings TextBlock.label">
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector=".settings ComboBox, .settings NumericUpDown, .settings TextBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector=".settings ComboBox">
        <Setter Property="Padding" Value="9,3,6,3" />
    </Style>
    <Style Selector=".settings NumericUpDown /template/ TextBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector=".settings TextBox">
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector=".settings CheckBox, .settings RadioButton">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector=".settings TextBlock.value">
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector=".settings TextBlock.hint">
        <Setter Property="FontSize" Value="10.5" />
    </Style>

    <!-- Kette etwas kleiner, passend zu den niedrigeren Feldern -->
    <!-- Format-Knopf über der Kette: genauso kompakt wie sie -->
    <Style Selector=".settings Button.paper">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector=".settings Button.paper Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector=".settings ToggleButton.chain">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector=".settings ToggleButton.chain Panel">
        <Setter Property="RenderTransform" Value="scale(0.82)" />
    </Style>

    <Style Selector=".settings Button.subtle, .settings Button.primary">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- ===================================================================
         Spenden: goldener Glasknopf —
         der harte Farbsprung in der Mitte macht den Glanz, oben hell, unten
         dunkler und zum Rand wieder heller wie eine gewölbte Fläche. Schrift
         schwarz, Herz rot; in heller und dunkler Darstellung gleich.
         =================================================================== -->
    <Style Selector="Button.donate">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="#C8940B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.donate /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="#C8940B" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFF3BE" />
                <GradientStop Offset="0.48" Color="#FFD256" />
                <GradientStop Offset="0.52" Color="#F7B300" />
                <GradientStop Offset="1" Color="#FFDE7C" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="Button.donate:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="#C8940B" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFAD8" />
                <GradientStop Offset="0.48" Color="#FFE083" />
                <GradientStop Offset="0.52" Color="#FFC02A" />
                <GradientStop Offset="1" Color="#FFEBA8" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="Button.donate:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#E5A400" />
                <GradientStop Offset="1" Color="#FFD256" />
            </LinearGradientBrush>
        </Setter>
    </Style>

</Styles>
