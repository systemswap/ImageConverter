<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         GroupBox
         Avalonia hat keinen GroupBox. HeaderedContentControl bringt die
         Struktur mit (Header + Content) und bekommt hier ein eigenes
         ControlTheme: Karte mit Rahmen, Titelzeile, Trennlinie.
         =================================================================== -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type HeaderedContentControl}" TargetType="HeaderedContentControl">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusCard}">
                        <DockPanel LastChildFill="True">
                            <!-- Titelzeile -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="7,7,0,0"
                                    Padding="12,6">
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  Content="{TemplateBinding Header}"
                                                  TextElement.FontSize="11"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <!-- Inhalt -->
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{DynamicResource CardPadding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- ===================================================================
         Typografie
         =================================================================== -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.good">
        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================================================================
         Leisten oben und unten
         =================================================================== -->
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ===================================================================
         Buttons
         =================================================================== -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <!-- Quadratische Icon-Buttons fuer die Zoom-/Dreh-Leiste -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Runde, schwebende Buttons in den Ecken der Vorschau (Drehen) -->
    <Style Selector="Button.corner">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.92" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Effect">
            <DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="1" Opacity="0.18" />
        </Setter>
    </Style>
    <Style Selector="Button.corner:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.corner:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.corner Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.corner:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Flache Textbuttons in der Werkzeugleiste (Rückgängig/Wiederholen) -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ===================================================================
         Eingabefelder
         =================================================================== -->
    <Style Selector="NumericUpDown">
        <Setter Property="FormatString" Value="0" />
        <Setter Property="ShowButtonSpinner" Value="False" />
        <Setter Property="Minimum" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <!-- Das abgeleitete Maß wird gedimmt: so sieht man, welcher Wert
         gerechnet ist und welcher getippt wurde. -->
    <Style Selector="NumericUpDown.derived:not(.leading)">
        <Setter Property="Opacity" Value="0.62" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,-4" />
    </Style>

    <!-- Kettensymbol: an = Akzentfarbe -->
    <Style Selector="ToggleButton.chain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.chain:checked /template/ ContentPresenter,
                     ToggleButton.chain:checked:pointerover /template/ ContentPresenter,
                     ToggleButton.chain:checked:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Reihe "Label ... Steuerelement" in den GroupBoxen -->
    <Style Selector="Grid.row">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ===================================================================
         Einstellungsspalte links: feiner und ruhiger
         Kleinere Schrift, niedrigere Felder, engere Zeilen. Gilt nur innerhalb
         von .settings, damit Kopf- und Fußleiste ihre Größe behalten.
         =================================================================== -->
    <Style Selector=".settings Grid.row">
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style Selector=".settings TextBlock.label">
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector=".settings ComboBox, .settings NumericUpDown, .settings TextBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector=".settings ComboBox">
        <Setter Property="Padding" Value="9,3,6,3" />
    </Style>
    <Style Selector=".settings NumericUpDown /template/ TextBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector=".settings TextBox">
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector=".settings CheckBox, .settings RadioButton">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector=".settings TextBlock.value">
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector=".settings TextBlock.hint">
        <Setter Property="FontSize" Value="10.5" />
    </Style>

    <!-- Kette etwas kleiner, passend zu den niedrigeren Feldern -->
    <Style Selector=".settings ToggleButton.chain">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector=".settings ToggleButton.chain Panel">
        <Setter Property="RenderTransform" Value="scale(0.82)" />
    </Style>

    <Style Selector=".settings Button.subtle, .settings Button.primary">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

</Styles>
