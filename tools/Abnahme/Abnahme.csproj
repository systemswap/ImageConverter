<Project Sdk="Microsoft.NET.Sdk">
    <!-- Abnahme der Bildkette gegen eine Referenzversion — nicht Teil der Solution.
         Aufruf im Repo: dotnet run -c Release (Projekt tools/Abnahme), dahinter der Befehl
         Die Testbilder liegen außerhalb des Repos (Arbeitsordner, siehe Program.cs).
         Mit -p:CoreProject=… gegen eine andere Fassung von ImageConverter.Core bauen
         (z. B. einen Worktree der Referenzversion). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <CoreProject Condition="'$(CoreProject)' == ''">..\..\ImageConverter.Core\ImageConverter.Core.csproj</CoreProject>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(CoreProject)" />
    </ItemGroup>
</Project>
