<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>

        <AssemblyName>ImageConverter</AssemblyName>
        <RootNamespace>ImageConverter.Desktop</RootNamespace>
        <Company>ImageConverter</Company>
        <Product>ImageConverter</Product>
        <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- Self-contained Single-File fuer Portable-exe und AppImage.
             InvariantGlobalization bleibt FALSE - wir brauchen Kulturen fuer die Lokalisierung. -->
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <!-- ReadyToRun: der Code wird beim Bauen übersetzt statt bei jedem Start (gemessen 13.10.2026: Start 2,3 s → 1,2 s,
             Datei 51 → 70 MB; ohne Kompression wären es 0,9 s, aber 161 MB und ein viel langsamerer erster Start nach dem Bau,
             weil Windows die größere Datei prüft) -->
        <PublishReadyToRun>true</PublishReadyToRun>
        <InvariantGlobalization>false</InvariantGlobalization>
        <DebugType>none</DebugType>
        <!-- PublishTrimmed vorerst aus: der ViewLocator nutzt Reflection.
             Erst messen, dann aktivieren. -->
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Programmsymbol der exe (Explorer, Taskleiste, Alt+Tab) -->
        <ApplicationIcon>../ImageConverter.Ui/Assets/app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ImageConverter.Ui\ImageConverter.Ui.csproj"/>
    </ItemGroup>

    <!-- Fremde native Bibliotheken nicht in die Programmdatei (EXE/AppImage), sondern je in
         einen eigenen Ordner daneben: Tools/ImageMagick, Tools/OnnxRuntime. In der Programmdatei
         bleiben nur Programm, .NET und Avalonia. Gefunden werden sie über
         Core/Platform/NativeLibraries.cs; die Ordnernamen müssen dazu passen. -->
    <Target Name="ForeignNativeLibrariesBesideProgram" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <_ImageMagickNative Include="@(ResolvedFileToPublish)"
                                Condition="$([System.String]::Copy('%(Filename)').StartsWith('Magick.Native-'))" />
            <_OnnxRuntimeNative Include="@(ResolvedFileToPublish)"
                                Condition="('%(Filename)' == 'onnxruntime' Or '%(Filename)' == 'libonnxruntime' Or '%(Filename)' == 'DirectML' Or $([System.String]::Copy('%(Filename)').Contains('onnxruntime_providers_')))
                                           And ('%(Extension)' == '.dll' Or '%(Extension)' == '.so' Or '%(Extension)' == '.dylib')" />
            <ResolvedFileToPublish Remove="@(_ImageMagickNative);@(_OnnxRuntimeNative)" />
            <ResolvedFileToPublish Include="@(_ImageMagickNative)">
                <RelativePath>Tools/ImageMagick/%(Filename)%(Extension)</RelativePath>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
            <ResolvedFileToPublish Include="@(_OnnxRuntimeNative)">
                <RelativePath>Tools/OnnxRuntime/%(Filename)%(Extension)</RelativePath>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
